---
/**
 * Die Startseite — "Die Naht".
 *
 * Diagonal geteilt; die Trennlinie ist der lange Weg aus der Bildmarke.
 * Links die Konsole (ein Spektrum, live gezeichnet), rechts der Blog
 * (das Aufmacherfoto des neuesten Beitrags). Zeigt man auf eine
 * Haelfte, wandert die Naht dorthin.
 *
 * Seit 2026-09-16 vier Streifen: zwischen Trainer und Blog liegt das
 * Contestprogramm, mit seiner Karte als Grund.
 */
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Wordmark from "../components/Wordmark.astro";
import Spektrum from "../components/Spektrum.astro";
import LangSwitch from "../components/LangSwitch.astro";
import contestKarte from "../assets/contest/streifen-karte.png";
import { alleBeitraege } from "../lib/sota";
import { useTranslations } from "../i18n/utils";
import { DEFAULT_LOCALE, LOCALE_TAG, type Locale } from "../i18n/ui";

const lang = (Astro.currentLocale as Locale | undefined) ?? DEFAULT_LOCALE;
const t = useTranslations(lang);

const beitraege = await alleBeitraege();

/* Fuer den Blog-Streifen zaehlt der neueste Beitrag MIT Gipfel.
   Der allerneueste kann ein Geraetevergleich sein; ein Funkgeraet
   unter der Ueberschrift "Fotos von den Gipfeln" verspricht das
   Falsche. Faellt auf den neuesten ueberhaupt zurueck, falls es noch
   keinen Gipfelbeitrag gibt.

   Betreiber, 2026-08-28: das Gitterkreuz-Foto (Hoellengebirge-Beitrag)
   soll vorlaeufig stehen bleiben, auch wenn ein neuerer Gipfelbeitrag
   erscheint -- ein bewusst angehaltener Stand, kein Automatismus.
   Faellt auf die alte, dynamische Regel zurueck, falls dieser Beitrag
   einmal nicht mehr existiert. */
const gehalten = beitraege.find((b) => b.id === "hoellengebirge-ueberquerung");
const neuester = gehalten
  ?? beitraege.find((b) => b.data.sota && b.data.aufmacher)
  ?? beitraege.find((b) => b.data.aufmacher);
---

<Base
  titel={t.home.titel}
  beschreibung={t.home.beschreibung}
  raum="app"
  nackt
>
  <div class="landing" id="landing">

    <a class="half half--app" href="/longpath/" data-f="a">
      <Spektrum art="band" grundlinie={0.62} />
      <div class="half__in">
        <p class="caps">{t.home.appKicker}</p>
        <div class="big"><Wordmark /></div>
        <p class="lede">{t.home.appLede}</p>
        <span class="go">{t.home.appGo} <span aria-hidden="true">→</span></span>
      </div>
    </a>

    <a class="half half--trainer" href="/trainer/" data-f="t">
      <Spektrum art="kurve" grundlinie={0.7} staerke={0.75} />
      <div class="half__in">
        <p class="caps">{t.home.trainerKicker}</p>
        <div class="big">TRAINER</div>
        <p class="lede">{t.home.trainerLede}</p>
        <span class="go">{t.home.trainerGo} <span aria-hidden="true">→</span></span>
      </div>
    </a>

    <a class="half half--contest" href="/contest/" data-f="c">
      <Image
        class="foto"
        src={contestKarte}
        alt=""
        widths={[720, 1200, 1800]}
        sizes="(max-width: 900px) 100vw, 40vw"
        loading="eager"
        format="avif"
      />
      <div class="half__in">
        <p class="caps">{t.home.contestKicker}</p>
        <div class="big">CONTEST</div>
        <p class="lede">{t.home.contestLede}</p>
        <span class="go">{t.home.contestGo} <span aria-hidden="true">→</span></span>
      </div>
    </a>

    <a class="half half--blog" href="/blog/" data-f="b">
      {neuester?.data.aufmacher && (
        <Image
          class="foto"
          src={neuester.data.aufmacher}
          alt={neuester.data.aufmacherAlt ?? ""}
          widths={[720, 1200, 1800]}
          sizes="(max-width: 900px) 100vw, 40vw"
          loading="eager"
          format="avif"
        />
      )}
      <div class="half__in">
        <p class="caps">{t.home.blogKicker}</p>
        <div class="big">BLOG</div>
        <p class="lede">{t.home.blogLede}</p>
        <span class="go">{t.home.blogGo} <span aria-hidden="true">→</span></span>
      </div>
    </a>

    <div class="seam seam--1" aria-hidden="true"></div>
    <div class="seam seam--2" aria-hidden="true"></div>
    <div class="seam seam--3" aria-hidden="true"></div>

    <div class="corner corner--t">
      <span class="caps">OE5SOS · Martin Fischer</span>
      <span class="corner__right">
        <span class="caps num">{t.home.cornerTop2}</span>
        <span class="corner__lang"><LangSwitch lang={lang} /></span>
      </span>
    </div>
    <div class="corner corner--b">
      <span class="caps">{t.home.cornerBottom1}</span>
      {neuester?.data.aufmacher && (
        <span class="caps num">
          {t.home.cornerBottomZuletzt} {neuester.data.sota?.referenz ?? ""} ·
          {" "}{neuester.data.datum.toLocaleDateString(LOCALE_TAG[lang])}
        </span>
      )}
    </div>
  </div>
</Base>

<style>
  .landing { position: relative; height: 100svh; min-height: 640px; overflow: hidden; background: var(--bg); }
  /* Traegt die Eckbeschriftung, egal wie hell das Foto oben ist. */
  .landing::before {
    content: ""; position: absolute; inset: 0 0 auto 0; height: 22%; z-index: 3;
    background: linear-gradient(to bottom, rgba(8,8,10,.6), transparent);
    pointer-events: none;
  }

  .half {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; justify-content: flex-end;
    padding: var(--pad) var(--pad) clamp(3rem, 9vh, 6rem);
    transition: clip-path .55s cubic-bezier(.22,.7,.3,1);
    will-change: clip-path;
  }
  .half canvas, .half :global(img) {
    position: absolute; inset: 0; z-index: 0;
    width: 100%; height: 100%; object-fit: cover; display: block;
  }
  .half::after {
    content: ""; position: absolute; inset: 0; z-index: 1; pointer-events: none;
  }
  /* Ueber dem Spektrum darf es dunkel sein — da steht nichts drunter. */
  .half--app::after {
    background: linear-gradient(to bottom, rgba(8,8,10,.28), rgba(8,8,10,.9));
  }
  /* Ueber dem Foto nur so viel, wie die Schrift zum Lesen braucht. */
  .half--blog::after {
    background: linear-gradient(to bottom,
      rgba(8,8,10,.22) 0%, rgba(8,8,10,.16) 30%, rgba(8,8,10,.55) 58%, rgba(8,8,10,.88) 78%, rgba(8,8,10,.95) 100%);
  }
  .half__in { position: relative; z-index: 2; max-width: 24ch; display: flex; flex-direction: column; gap: .5rem; }
  /* Der Zuschnitt schneidet alles weg, was ausserhalb des Keils liegt.
     Also muss jeder Textblock IN seinem Keil sitzen, nicht am linken
     Rand der Seite. */
  .half--trainer .half__in { margin-left: 22%; }
  .half--contest .half__in { margin-left: 47%; }
  .half--blog    .half__in { margin-left: auto; align-items: flex-end; }

  /* Vier Streifen.
     Die Zuschnitte teilen bei 25 %, 50 % und 75 %, jeweils sechs
     Prozent schraeg — die Naht ist der lange Weg aus der Bildmarke,
     und die bleibt schraeg. */
  .half--app     { background: var(--bg);      clip-path: polygon(0 0, 31% 0, 19% 100%, 0 100%); }
  .half--trainer { background: var(--panel);   clip-path: polygon(31% 0, 56% 0, 44% 100%, 19% 100%); }
  .half--contest { background: var(--panel);   clip-path: polygon(56% 0, 81% 0, 69% 100%, 44% 100%); }
  .half--blog    { background: var(--panel-2); clip-path: polygon(81% 0, 100% 0, 100% 100%, 69% 100%);
                   align-items: flex-end; text-align: right; }
  .half--blog .half__in { margin-left: auto; align-items: flex-end; }

  /* Ueber der Zeichnung darf es dunkel sein, ueber dem Foto nur so
     viel, wie die Schrift zum Lesen braucht. Die Contest-Karte ist
     selbst schon dunkel; sie bekommt den Foto-Schleier. */
  .half--app::after,
  .half--trainer::after {
    background: linear-gradient(to bottom, rgba(8,8,10,.3) 0%, rgba(8,8,10,.9) 100%);
  }
  .half--contest::after,
  .half--blog::after {
    background: linear-gradient(to bottom,
      rgba(8,8,10,.22) 0%, rgba(8,8,10,.16) 30%, rgba(8,8,10,.62) 62%, rgba(8,8,10,.95) 100%);
  }

  /* Der Streifen unter dem Zeiger waechst, die drei anderen weichen.
     Vier Zustaende, je drei Zuschnitte und drei Naehte. */
  .landing[data-f="a"] .half--app     { clip-path: polygon(0 0, 52% 0, 40% 100%, 0 100%); }
  .landing[data-f="a"] .half--trainer { clip-path: polygon(52% 0, 70% 0, 58% 100%, 40% 100%); }
  .landing[data-f="a"] .half--contest { clip-path: polygon(70% 0, 88% 0, 76% 100%, 58% 100%); }
  .landing[data-f="a"] .half--blog    { clip-path: polygon(88% 0, 100% 0, 100% 100%, 76% 100%); }

  .landing[data-f="t"] .half--app     { clip-path: polygon(0 0, 24% 0, 12% 100%, 0 100%); }
  .landing[data-f="t"] .half--trainer { clip-path: polygon(24% 0, 70% 0, 58% 100%, 12% 100%); }
  .landing[data-f="t"] .half--contest { clip-path: polygon(70% 0, 88% 0, 76% 100%, 58% 100%); }
  .landing[data-f="t"] .half--blog    { clip-path: polygon(88% 0, 100% 0, 100% 100%, 76% 100%); }

  .landing[data-f="c"] .half--app     { clip-path: polygon(0 0, 24% 0, 12% 100%, 0 100%); }
  .landing[data-f="c"] .half--trainer { clip-path: polygon(24% 0, 42% 0, 30% 100%, 12% 100%); }
  .landing[data-f="c"] .half--contest { clip-path: polygon(42% 0, 88% 0, 76% 100%, 30% 100%); }
  .landing[data-f="c"] .half--blog    { clip-path: polygon(88% 0, 100% 0, 100% 100%, 76% 100%); }

  .landing[data-f="b"] .half--app     { clip-path: polygon(0 0, 24% 0, 12% 100%, 0 100%); }
  .landing[data-f="b"] .half--trainer { clip-path: polygon(24% 0, 42% 0, 30% 100%, 12% 100%); }
  .landing[data-f="b"] .half--contest { clip-path: polygon(42% 0, 60% 0, 48% 100%, 30% 100%); }
  .landing[data-f="b"] .half--blog    { clip-path: polygon(60% 0, 100% 0, 100% 100%, 48% 100%); }

  /* Wer weicht, tritt zurueck.
     Der Zuschnitt schneidet den Text der schrumpfenden Streifen mitten
     im Wort ab. Nimmt man ihnen gleichzeitig etwas Helligkeit, liest
     sich das als Zuruecktreten statt als abgeschnitten. */
  .half__in { transition: opacity .4s ease; }
  .landing[data-f] .half__in { opacity: .38; }
  .landing[data-f="a"] .half--app     .half__in,
  .landing[data-f="t"] .half--trainer .half__in,
  .landing[data-f="c"] .half--contest .half__in,
  .landing[data-f="b"] .half--blog    .half__in { opacity: 1; }

  /* Die drei Naehte. Sie wandern mit den Zuschnitten: `left` steht
     jeweils dort, wo der Zuschnitt auf halber Hoehe durchgeht. */
  /* Der lange Weg als Naht — 1 px, dezent. Die Farbe traegt die Marke,
     nicht der Grund. Die Lage kommt aus .seam--1 / .seam--2 / .seam--3. */
  .seam {
    position: absolute; z-index: 3;
    top: -20%; width: 1px; height: 140%;
    transform: translateX(-50%) rotate(14.5deg);
    background: linear-gradient(to bottom, transparent,
      rgba(194,146,79,.16) 22%, var(--measured) 50%, rgba(194,146,79,.16) 78%, transparent);
    box-shadow: 0 0 0 1px rgba(8,8,10,.55), 0 0 14px 2px rgba(194,146,79,.2);
    pointer-events: none;
    transition: left .55s cubic-bezier(.22,.7,.3,1);
  }

  .seam--1 { left: 25%; }
  .seam--2 { left: 50%; }
  .seam--3 { left: 75%; }
  .landing[data-f="a"] .seam--1 { left: 46%; }
  .landing[data-f="a"] .seam--2 { left: 64%; }
  .landing[data-f="a"] .seam--3 { left: 82%; }
  .landing[data-f="t"] .seam--1 { left: 18%; }
  .landing[data-f="t"] .seam--2 { left: 64%; }
  .landing[data-f="t"] .seam--3 { left: 82%; }
  .landing[data-f="c"] .seam--1 { left: 18%; }
  .landing[data-f="c"] .seam--2 { left: 36%; }
  .landing[data-f="c"] .seam--3 { left: 82%; }
  .landing[data-f="b"] .seam--1 { left: 18%; }
  .landing[data-f="b"] .seam--2 { left: 36%; }
  .landing[data-f="b"] .seam--3 { left: 54%; }

  .big {
    font-family: var(--ff-cond); font-weight: 600; letter-spacing: .05em;
    line-height: 1; color: var(--t1);
    font-size: clamp(1.9rem, 4.4vw, 3.4rem); margin: .3rem 0 0;
  }
  .big :global(.wm) { font-size: inherit; }
  .lede { margin: .45rem 0 0; color: var(--t4); font-size: .95rem; max-width: 26ch; }
  /* Ueber einem Foto steht Skalengrau zu schwach. Eine Stufe hoeher,
     aber nur auf der Blog-Haelfte — die Konsolenseite bleibt ruhig. */
  .half--blog .caps { color: var(--t3); }
  .half--blog .lede { color: var(--t2); }
  .half:hover .go { gap: .9rem; color: var(--t1); border-color: var(--border-2); }

  .corner {
    position: absolute; z-index: 4; left: 0; right: 0;
    display: flex; justify-content: space-between; gap: 1rem;
    padding-inline: var(--pad); pointer-events: none;
  }
  .corner--t { top: clamp(1.1rem, 3.4vh, 2.1rem); }
  .corner--b { bottom: clamp(1rem, 3vh, 1.8rem); }
  /* Die Sprachlinks sind das einzige Klickbare in den sonst
     durchlaessigen Ecken — nur sie bekommen pointer-events zurueck. */
  .corner__right { display: flex; align-items: center; gap: .9rem; }
  .corner__lang { pointer-events: auto; }

  @media (max-width: 900px) {
    .landing { height: auto; min-height: 0; }
    .half {
      position: relative; clip-path: none !important;
      min-height: 38svh; padding-top: clamp(3.5rem, 9vh, 5rem);
    }
    .half--blog { text-align: left; align-items: flex-start; }
    .half--blog .half__in { margin-left: 0; align-items: flex-start; }
    .half--trainer .half__in, .half--contest .half__in { margin-left: 0; }
    /* Die Naht haengt an der Kante des jeweils naechsten Feldes. */
    .seam { display: none; }
    .half--trainer, .half--contest, .half--blog {
      border-top: 1px solid transparent;
      border-image: linear-gradient(to right, transparent, var(--measured) 50%, transparent) 1;
    }
    .corner--b { position: relative; flex-direction: column; gap: .25rem; padding-block: 1.5rem; }
  }

</style>

<script>
  /* Die Naht folgt dem Zeiger. */
  const landing = document.getElementById("landing");
  if (landing) {
    for (const el of landing.querySelectorAll<HTMLElement>("[data-f]")) {
      const an = () => landing.setAttribute("data-f", el.dataset.f!);
      el.addEventListener("mouseenter", an);
      el.addEventListener("focus", an);
    }
    landing.addEventListener("mouseleave", () => landing.removeAttribute("data-f"));
  }

</script>
