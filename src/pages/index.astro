---
/**
 * Die Startseite — "Die Naht".
 *
 * Diagonal geteilt; die Trennlinie ist der lange Weg aus der Bildmarke.
 * Links die Konsole (ein Spektrum, live gezeichnet), rechts der Blog
 * (das Aufmacherfoto des neuesten Beitrags). Zeigt man auf eine
 * Haelfte, wandert die Naht dorthin.
 */
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Wordmark from "../components/Wordmark.astro";
import Spektrum from "../components/Spektrum.astro";
import { alleBeitraege } from "../lib/sota";

const beitraege = await alleBeitraege();

/* Fuer den Blog-Streifen zaehlt der neueste Beitrag MIT Gipfel.
   Der allerneueste kann ein Geraetevergleich sein; ein Funkgeraet
   unter der Ueberschrift "Fotos von den Gipfeln" verspricht das
   Falsche. Faellt auf den neuesten ueberhaupt zurueck, falls es noch
   keinen Gipfelbeitrag gibt. */
const neuester = beitraege.find((b) => b.data.sota) ?? beitraege[0];
---

<Base
  titel="Longpath — Stationskonsole und Blog"
  beschreibung="Longpath: eine native OpenHPSDR-Stationskonsole für macOS, Linux und Windows. Dazu ein Blog von den Gipfeln über dem Traunsee."
  raum="app"
  nackt
>
  <div class="landing" id="landing">

    <a class="half half--app" href="/longpath/" data-f="a">
      <Spektrum art="band" grundlinie={0.62} />
      <div class="half__in">
        <p class="caps">OpenHPSDR · Protokoll 1 + 2</p>
        <div class="big"><Wordmark /></div>
        <p class="lede">Die Stationskonsole. Nativ für macOS, Linux und Windows.</p>
        <span class="go">Zur App <span aria-hidden="true">→</span></span>
      </div>
    </a>

    <a class="half half--trainer" href="/trainer/" data-f="t">
      <Spektrum art="kurve" grundlinie={0.7} staerke={0.75} />
      <div class="half__in">
        <p class="caps">Im Browser, ohne Anmeldung</p>
        <div class="big">TRAINER</div>
        <p class="lede">Contest üben — Pile-Up, QSB und QRM, in SSB und CW.</p>
        <span class="go">Zum Üben <span aria-hidden="true">→</span></span>
      </div>
    </a>

    <a class="half half--blog" href="/blog/" data-f="b">
      {neuester && (
        <Image
          class="foto"
          src={neuester.data.aufmacher}
          alt={neuester.data.aufmacherAlt}
          widths={[720, 1200, 1800]}
          sizes="(max-width: 900px) 100vw, 40vw"
          loading="eager"
          format="avif"
        />
      )}
      <div class="half__in">
        <p class="caps">Summits on the Air · OE/OO</p>
        <div class="big">BLOG</div>
        <p class="lede">Fotos und Notizen von den Gipfeln.</p>
        <span class="go">Zum Blog <span aria-hidden="true">→</span></span>
      </div>
    </a>

    <div class="seam seam--1" aria-hidden="true"></div>
    <div class="seam seam--2" aria-hidden="true"></div>

    <div class="corner corner--t">
      <span class="caps">OE5SOS · Martin Fischer</span>
      <span class="caps num">JN67 · Gmunden</span>
    </div>
    <div class="corner corner--b">
      <span class="caps">Drei Wege, eine Station</span>
      {neuester && (
        <span class="caps num">
          Zuletzt {neuester.data.sota?.referenz ?? ""} ·
          {" "}{neuester.data.datum.toLocaleDateString("de-AT")}
        </span>
      )}
    </div>
  </div>
</Base>

<style>
  .landing { position: relative; height: 100svh; min-height: 640px; overflow: hidden; background: var(--bg); }
  /* Traegt die Eckbeschriftung, egal wie hell das Foto oben ist. */
  .landing::before {
    content: ""; position: absolute; inset: 0 0 auto 0; height: 22%; z-index: 3;
    background: linear-gradient(to bottom, rgba(8,8,10,.6), transparent);
    pointer-events: none;
  }

  .half {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; justify-content: flex-end;
    padding: var(--pad) var(--pad) clamp(3rem, 9vh, 6rem);
    transition: clip-path .55s cubic-bezier(.22,.7,.3,1);
    will-change: clip-path;
  }
  .half canvas, .half :global(img) {
    position: absolute; inset: 0; z-index: 0;
    width: 100%; height: 100%; object-fit: cover; display: block;
  }
  .half::after {
    content: ""; position: absolute; inset: 0; z-index: 1; pointer-events: none;
  }
  /* Ueber dem Spektrum darf es dunkel sein — da steht nichts drunter. */
  .half--app::after {
    background: linear-gradient(to bottom, rgba(8,8,10,.28), rgba(8,8,10,.9));
  }
  /* Ueber dem Foto nur so viel, wie die Schrift zum Lesen braucht. */
  .half--blog::after {
    background: linear-gradient(to bottom,
      rgba(8,8,10,.22) 0%, rgba(8,8,10,.16) 30%, rgba(8,8,10,.55) 58%, rgba(8,8,10,.88) 78%, rgba(8,8,10,.95) 100%);
  }
  .half__in { position: relative; z-index: 2; max-width: 24ch; display: flex; flex-direction: column; gap: .5rem; }
  /* Der Zuschnitt schneidet alles weg, was ausserhalb des Keils liegt.
     Also muss jeder Textblock IN seinem Keil sitzen, nicht am linken
     Rand der Seite. */
  .half--trainer .half__in { margin-left: 34%; }
  .half--blog    .half__in { margin-left: auto; align-items: flex-end; }

  /* Drei Streifen statt zwei Haelften.
     Die Zuschnitte teilen bei 34 % und 67 %, mit derselben Neigung wie
     zuvor — die Naht ist der lange Weg aus der Bildmarke, und die
     bleibt schraeg. */
  .half--app     { background: var(--bg);      clip-path: polygon(0 0, 40% 0, 28% 100%, 0 100%); }
  .half--trainer { background: var(--panel);   clip-path: polygon(40% 0, 72% 0, 60% 100%, 28% 100%); }
  .half--blog    { background: var(--panel-2); clip-path: polygon(72% 0, 100% 0, 100% 100%, 60% 100%);
                   align-items: flex-end; text-align: right; }
  .half--blog .half__in { margin-left: auto; align-items: flex-end; }

  /* Ueber der Zeichnung darf es dunkel sein, ueber dem Foto nur so
     viel, wie die Schrift zum Lesen braucht. */
  .half--app::after,
  .half--trainer::after {
    background: linear-gradient(to bottom, rgba(8,8,10,.3) 0%, rgba(8,8,10,.9) 100%);
  }
  .half--blog::after {
    background: linear-gradient(to bottom,
      rgba(8,8,10,.22) 0%, rgba(8,8,10,.16) 30%, rgba(8,8,10,.62) 62%, rgba(8,8,10,.95) 100%);
  }

  /* Der Streifen unter dem Zeiger waechst, die beiden anderen weichen.
     Drei Zustaende, je zwei Zuschnitte und zwei Naehte. */
  .landing[data-f="a"] .half--app     { clip-path: polygon(0 0, 56% 0, 44% 100%, 0 100%); }
  .landing[data-f="a"] .half--trainer { clip-path: polygon(56% 0, 80% 0, 68% 100%, 44% 100%); }
  .landing[data-f="a"] .half--blog    { clip-path: polygon(80% 0, 100% 0, 100% 100%, 68% 100%); }

  .landing[data-f="t"] .half--app     { clip-path: polygon(0 0, 28% 0, 16% 100%, 0 100%); }
  .landing[data-f="t"] .half--trainer { clip-path: polygon(28% 0, 80% 0, 68% 100%, 16% 100%); }
  .landing[data-f="t"] .half--blog    { clip-path: polygon(80% 0, 100% 0, 100% 100%, 68% 100%); }

  .landing[data-f="b"] .half--app     { clip-path: polygon(0 0, 28% 0, 16% 100%, 0 100%); }
  .landing[data-f="b"] .half--trainer { clip-path: polygon(28% 0, 52% 0, 40% 100%, 16% 100%); }
  .landing[data-f="b"] .half--blog    { clip-path: polygon(52% 0, 100% 0, 100% 100%, 40% 100%); }

  /* Wer weicht, tritt zurueck.
     Der Zuschnitt schneidet den Text der schrumpfenden Streifen mitten
     im Wort ab. Nimmt man ihnen gleichzeitig etwas Helligkeit, liest
     sich das als Zuruecktreten statt als abgeschnitten. */
  .half__in { transition: opacity .4s ease; }
  .landing[data-f="a"] .half--trainer .half__in,
  .landing[data-f="a"] .half--blog    .half__in,
  .landing[data-f="t"] .half--app     .half__in,
  .landing[data-f="t"] .half--blog    .half__in,
  .landing[data-f="b"] .half--app     .half__in,
  .landing[data-f="b"] .half--trainer .half__in { opacity: .38; }

  /* Die zwei Naehte. Sie wandern mit den Zuschnitten. */
  /* Der lange Weg als Naht — 1 px, dezent. Die Farbe traegt die Marke,
     nicht der Grund. Die Lage kommt aus .seam--1 / .seam--2. */
  .seam {
    position: absolute; z-index: 3;
    top: -20%; width: 1px; height: 140%;
    transform: translateX(-50%) rotate(14.5deg);
    background: linear-gradient(to bottom, transparent,
      rgba(194,146,79,.16) 22%, var(--measured) 50%, rgba(194,146,79,.16) 78%, transparent);
    box-shadow: 0 0 0 1px rgba(8,8,10,.55), 0 0 14px 2px rgba(194,146,79,.2);
    pointer-events: none;
    transition: transform .55s cubic-bezier(.22,.7,.3,1);
  }

  .seam--1 { left: 34%; }
  .seam--2 { left: 66%; }
  .landing[data-f="a"] .seam--1 { transform: translateX(-50%) rotate(14.5deg) translateX(184px); }
  .landing[data-f="a"] .seam--2 { transform: translateX(-50%) rotate(14.5deg) translateX(128px); }
  .landing[data-f="t"] .seam--1 { transform: translateX(-50%) rotate(14.5deg) translateX(-72px); }
  .landing[data-f="t"] .seam--2 { transform: translateX(-50%) rotate(14.5deg) translateX(128px); }
  .landing[data-f="b"] .seam--1 { transform: translateX(-50%) rotate(14.5deg) translateX(-72px); }
  .landing[data-f="b"] .seam--2 { transform: translateX(-50%) rotate(14.5deg) translateX(-128px); }

  .big {
    font-family: var(--ff-cond); font-weight: 600; letter-spacing: .05em;
    line-height: 1; color: var(--t1);
    font-size: clamp(1.9rem, 4.4vw, 3.4rem); margin: .3rem 0 0;
  }
  .big :global(.wm) { font-size: inherit; }
  .lede { margin: .45rem 0 0; color: var(--t4); font-size: .95rem; max-width: 26ch; }
  /* Ueber einem Foto steht Skalengrau zu schwach. Eine Stufe hoeher,
     aber nur auf der Blog-Haelfte — die Konsolenseite bleibt ruhig. */
  .half--blog .caps { color: var(--t3); }
  .half--blog .lede { color: var(--t2); }
  .half:hover .go { gap: .9rem; color: var(--t1); border-color: var(--border-2); }

  .corner {
    position: absolute; z-index: 4; left: 0; right: 0;
    display: flex; justify-content: space-between; gap: 1rem;
    padding-inline: var(--pad); pointer-events: none;
  }
  .corner--t { top: clamp(1.1rem, 3.4vh, 2.1rem); }
  .corner--b { bottom: clamp(1rem, 3vh, 1.8rem); }

  @media (max-width: 900px) {
    .landing { height: auto; min-height: 0; }
    .half {
      position: relative; clip-path: none !important;
      min-height: 38svh; padding-top: clamp(3.5rem, 9vh, 5rem);
    }
    .half--blog { text-align: left; align-items: flex-start; }
    .half--blog .half__in { margin-left: 0; align-items: flex-start; }
    /* Die Naht haengt an der Kante des jeweils naechsten Feldes. */
    .seam { display: none; }
    .half--trainer, .half--blog {
      border-top: 1px solid transparent;
      border-image: linear-gradient(to right, transparent, var(--measured) 50%, transparent) 1;
    }
    .corner--b { position: relative; flex-direction: column; gap: .25rem; padding-block: 1.5rem; }
  }

</style>

<script>
  /* Die Naht folgt dem Zeiger. */
  const landing = document.getElementById("landing");
  if (landing) {
    for (const el of landing.querySelectorAll<HTMLElement>("[data-f]")) {
      const an = () => landing.setAttribute("data-f", el.dataset.f!);
      el.addEventListener("mouseenter", an);
      el.addEventListener("focus", an);
    }
    landing.addEventListener("mouseleave", () => landing.removeAttribute("data-f"));
  }

</script>
