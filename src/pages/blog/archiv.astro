---
import Base from "../../layouts/Base.astro";
import { alleBeitraege, nachJahr, jahresbilanz, datumKurz, wert } from "../../lib/sota";

const jahre = nachJahr(await alleBeitraege());
---

<Base titel="Archiv — Longpath Blog"
      beschreibung="Alle Beiträge chronologisch."
      raum="blog">
  <main class="wrap">
    <header class="hero">
      <p class="caps">Alle Beiträge</p>
      <h1>ARCHIV</h1>
      <p>Chronologisch, ohne Bilder — zum Suchen, nicht zum Blättern.</p>
    </header>

    {jahre.map(([jahr, beitraege]) => {
      const b = jahresbilanz(beitraege);
      return (
        <>
          <div class="year">
            <h2>{jahr}</h2>
            <span class="caps num">
              {b.beitraege} Beiträge · {b.gipfel} Gipfel
               · {b.punkte} Punkte
            </span>
          </div>
          <div class="rows">
            {beitraege.map((p) => (
              <a class="row" href={`/blog/${p.id}/`}>
                <span class="row__date">{datumKurz(p.data.datum)}</span>
                <span class="row__title">{p.data.titel}</span>
                <span class="row__ref">{wert(p.data.sota?.referenz)}</span>
              </a>
            ))}
          </div>
        </>
      );
    })}
  </main>
</Base>

<style>
  .hero { padding: clamp(3rem, 9vh, 6rem) 0 clamp(1rem, 3vh, 2rem); display: flex; flex-direction: column; gap: .7rem; }
  .hero h1 { font-size: clamp(2.2rem, 6.5vw, 4.2rem); letter-spacing: .05em; }
  .hero p:not(.caps) { margin: .3rem 0 0; max-width: 48ch; color: var(--t4); }

  .year { display: flex; align-items: baseline; gap: 1rem; padding: clamp(2rem, 5vh, 3rem) 0 .8rem; }
  .year h2 { font-size: clamp(1.6rem, 3.4vw, 2.2rem); }
  .year .caps { flex: 1; text-align: right; }

  .rows { display: flex; flex-direction: column; border-top: 1px solid var(--border); }
  .row {
    display: grid; grid-template-columns: 7.5rem 1fr 8rem;
    gap: 1rem; align-items: center;
    padding: .95rem 0; border-bottom: 1px solid var(--border-fine);
    transition: background var(--ease);
  }
  .row:hover { background: var(--panel); }
  .row__title { font-family: var(--ff-cond); font-weight: 500; font-size: 1.15rem; color: var(--t2); transition: color var(--ease); }
  .row:hover .row__title { color: var(--t1); }
  .row__date, .row__ref {
    font-family: var(--ff-mono); font-size: .74rem; color: var(--t5); font-variant-numeric: tabular-nums;
  }
  @media (max-width: 680px) {
    .row { grid-template-columns: 1fr auto; row-gap: .2rem; }
    .row__date { grid-column: 1; }
    .row__title, .row__ref { grid-column: 1 / -1; }
  }
</style>
