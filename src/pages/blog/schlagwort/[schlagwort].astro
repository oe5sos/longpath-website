---
import Base from "../../../layouts/Base.astro";
import PostCard from "../../../components/PostCard.astro";
import { alleBeitraege, schlagworte, alsAdresse, type Beitrag } from "../../../lib/sota";
import { useTranslations } from "../../../i18n/utils";
import { DEFAULT_LOCALE, type Locale } from "../../../i18n/ui";

export async function getStaticPaths() {
  const beitraege = await alleBeitraege();
  return schlagworte(beitraege).map((s) => ({
    params: { schlagwort: alsAdresse(s) },
    props: { schlagwort: s, treffer: beitraege.filter((b) => b.data.schlagworte.includes(s)) },
  }));
}

interface Props { schlagwort: string; treffer: Beitrag[]; }
const { schlagwort, treffer } = Astro.props;
const lang = (Astro.currentLocale as Locale | undefined) ?? DEFAULT_LOCALE;
const t = useTranslations(lang);
const alle = await alleBeitraege();
const marken = schlagworte(alle).slice(0, 6);
---

<Base titel={`${schlagwort} — Longpath Blog`}
      beschreibung={`${t.schlagwort.kicker}: ${schlagwort}`}
      raum="blog">
  <main class="wrap">
    <header class="hero">
      <p class="caps">{t.schlagwort.kicker}</p>
      <h1>{schlagwort.toUpperCase()}</h1>
      <p>{treffer.length} {t.schlagwort.beitragWort(treffer.length)}</p>
    </header>

    <div class="filters">
      <a class="filter" href="/blog/">{t.blogIndex.alle}</a>
      {marken.map((m) => (
        <a class="filter" href={`/blog/schlagwort/${alsAdresse(m)}/`}
           aria-current={m === schlagwort ? "page" : undefined}>{m}</a>
      ))}
    </div>

    <section class="posts">
      {treffer.map((b) => <PostCard beitrag={b} lang={lang} />)}
    </section>
  </main>
</Base>

<style>
  .hero { padding: clamp(3rem, 9vh, 6rem) 0 clamp(1.5rem, 4vh, 2.5rem); display: flex; flex-direction: column; gap: .7rem; }
  .hero h1 { font-size: clamp(2rem, 5.5vw, 3.6rem); letter-spacing: .05em; }
  .hero p:not(.caps) { margin: 0; color: var(--t4); }
  .filters { display: flex; flex-wrap: wrap; gap: .4rem; padding-bottom: clamp(1.5rem, 4vh, 2.5rem); }
  .filter {
    font-family: var(--ff-mono); font-size: 9px; font-weight: 500;
    letter-spacing: .16em; text-transform: uppercase;
    color: var(--t5); background: var(--btn); border: 1px solid var(--border-fine);
    border-radius: var(--radius-s); padding: .4rem .7rem;
    transition: color var(--ease), border-color var(--ease);
  }
  .filter:hover { color: var(--t2); border-color: var(--border); }
  .filter[aria-current] {
    color: var(--sel-text);
    background: linear-gradient(to bottom, var(--sel-bg), var(--sel-bg-2));
    border-color: var(--sel-border);
  }
  .posts {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(285px, 1fr));
    gap: clamp(1.6rem, 3.6vw, 2.6rem); padding-bottom: clamp(2.5rem, 6vh, 4rem);
  }
</style>
