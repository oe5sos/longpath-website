---
import Base from "../../layouts/Base.astro";
import Readout from "../../components/Readout.astro";
import { alleBeitraege, nurAktivierungen, jahresbilanz } from "../../lib/sota";
import { useTranslations } from "../../i18n/utils";
import { DEFAULT_LOCALE, LOCALE_TAG, type Locale } from "../../i18n/ui";

const lang = (Astro.currentLocale as Locale | undefined) ?? DEFAULT_LOCALE;
const t = useTranslations(lang);

const beitraege = await alleBeitraege();
const akt = nurAktivierungen(beitraege);
const b = jahresbilanz(beitraege);
/* Nur Gipfel mit bekannter Hoehe koennen der hoechste sein.
   Regel 7: was nicht gemessen wurde, zaehlt nicht mit. */
const mitHoehe = akt.filter((b) => typeof b.data.sota?.hoehe === "number");
const hoechster = mitHoehe.length
  ? mitHoehe.reduce((a, c) => (c.data.sota!.hoehe! > a.data.sota!.hoehe! ? c : a))
  : undefined;
const weiteste = akt.reduce<number | undefined>(
  (m, c) => (c.data.funk?.weiteste && (!m || c.data.funk.weiteste > m) ? c.data.funk.weiteste : m),
  undefined,
);
---
<Base titel={t.station.titel}
      beschreibung={t.station.beschreibung}
      raum="blog">
  <main class="wrap seite">
    <p class="caps">OE5SOS · JN67</p>
    <h1>{t.station.h1}</h1>

    <Readout titel={t.station.bisher} felder={[
      { k: t.station.beitraege, v: b.beitraege },
      { k: t.station.gipfel,   v: b.gipfel },
      { k: t.station.punkte,   v: b.punkte },
      { k: t.station.hoechster, v: hoechster ? `${hoechster.data.sota!.hoehe!.toLocaleString(LOCALE_TAG[lang])} m` : undefined },
      { k: t.station.weiteste, v: weiteste ? `${weiteste.toLocaleString(LOCALE_TAG[lang])} km` : undefined },
    ]} />

    <div class="text">
      <p>{t.station.text}</p>
    </div>
  </main>
</Base>

<style>
  .seite { padding-block: clamp(3rem, 9vh, 6rem); }
  .seite h1 { font-size: clamp(2rem, 5vw, 3.2rem); margin: .6rem 0 0; }
  .text { max-width: var(--measure); }
  .text a { color: var(--t2); border-bottom: 1px solid var(--border-2); }
  .text a:hover { color: var(--t1); border-color: var(--measured); }
</style>
