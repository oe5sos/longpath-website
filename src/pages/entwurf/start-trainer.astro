---
/**
 * Drei Vorschlaege, wie der Contesttrainer auf die Startseite kommt.
 * Nicht verlinkt, nicht in der Sitemap.
 */
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Wordmark from "../../components/Wordmark.astro";
import Spektrum from "../../components/Spektrum.astro";
import { alleBeitraege } from "../../lib/sota";

const neuester = (await alleBeitraege())[0];
---

<Base titel="Entwurf — Trainer auf der Startseite"
      beschreibung="Drei Vorschläge, wie der Contesttrainer auf die Startseite kommt."
      raum="app" nackt>

  <nav class="leiste">
    <a href="/"><Wordmark /></a>
    <span class="caps">Entwurf · Trainer auf der Startseite</span>
  </nav>

  <!-- ── 01 ────────────────────────────────────────────── -->
  <section class="blatt">
    <div class="wrap kopf">
      <span class="caps num" style="color:var(--measured)">Entwurf 01</span>
      <h2>Der dritte Keil</h2>
      <p>Aus zwei Hälften werden drei Streifen, zwei Nähte statt einer. Alle drei
        gleichberechtigt. Ehrlich, wenn der Trainer dir so viel wert ist wie App und
        Blog — aber die Weiche verliert ihre Schärfe: aus einer Entscheidung werden drei
        Angebote, und der Blick hat keinen Ruhepunkt mehr.</p>
    </div>
    <div class="buehne">
      <div class="drei" id="d1">
        <a class="drei__teil t-app" href="/longpath/" data-f="a">
          <Spektrum art="band" grundlinie={0.62} />
          <div class="in"><p class="caps">OpenHPSDR</p><div class="gross"><Wordmark /></div>
            <span class="go">Zur App →</span></div>
        </a>
        <a class="drei__teil t-trainer" href="/trainer/" data-f="t">
          <div class="in"><p class="caps">Üben</p><div class="gross">TRAINER</div>
            <span class="go">Contest üben →</span></div>
        </a>
        <a class="drei__teil t-blog" href="/blog/" data-f="b">
          {neuester && <Image class="foto" src={neuester.data.aufmacher} alt="" widths={[600,1000]} sizes="40vw" format="avif" />}
          <div class="in"><p class="caps">SOTA</p><div class="gross">BLOG</div>
            <span class="go">Zum Blog →</span></div>
        </a>
        <div class="naht n1"></div><div class="naht n2"></div>
      </div>
    </div>
  </section>

  <!-- ── 02 ────────────────────────────────────────────── -->
  <section class="blatt">
    <div class="wrap kopf">
      <span class="caps num" style="color:var(--measured)">Entwurf 02</span>
      <h2>Die Zeile unten</h2>
      <p>Die Weiche bleibt, wie sie ist. Der Trainer sitzt als ruhige Zeile in der
        Fußleiste — sichtbar, aber nicht gleichrangig. Das entspricht der Sache: er ist
        ein eigenes Werkzeug, aber nicht die dritte Säule neben Programm und Blog.
        Kostet keinen Platz und ändert nichts an dem, was funktioniert.</p>
    </div>
    <div class="buehne">
      <div class="zwei" id="d2">
        <a class="zwei__h h-app" href="/longpath/" data-f="a">
          <Spektrum art="band" grundlinie={0.55} />
          <div class="in"><p class="caps">OpenHPSDR · Protokoll 1 + 2</p>
            <div class="gross"><Wordmark /></div><span class="go">Zur App →</span></div>
        </a>
        <a class="zwei__h h-blog" href="/blog/" data-f="b">
          {neuester && <Image class="foto" src={neuester.data.aufmacher} alt="" widths={[700,1200]} sizes="60vw" format="avif" />}
          <div class="in"><p class="caps">Summits on the Air</p>
            <div class="gross">BLOG</div><span class="go">Zum Blog →</span></div>
        </a>
        <div class="naht mitte"></div>
        <div class="fuss">
          <span class="caps">OE5SOS · JN67</span>
          <a class="fuss__link caps" href="/trainer/">Contesttrainer — SSB und CW üben →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 03 ────────────────────────────────────────────── -->
  <section class="blatt">
    <div class="wrap kopf">
      <span class="caps num" style="color:var(--measured)">Entwurf 03</span>
      <h2>Das Band darunter</h2>
      <p>Die Weiche wird etwas flacher, darunter läuft ein eigenes Feld über die volle
        Breite. Der Trainer bekommt Gewicht, ohne die Entscheidung zwischen App und Blog
        zu stören — man trifft sie zuerst und sieht das dritte Angebot danach. Mein
        Vorschlag, wenn der Trainer mehr sein soll als eine Fußnote.</p>
    </div>
    <div class="buehne buehne--hoch">
      <div class="zwei kurz" id="d3">
        <a class="zwei__h h-app" href="/longpath/" data-f="a">
          <Spektrum art="band" grundlinie={0.55} />
          <div class="in"><p class="caps">OpenHPSDR</p>
            <div class="gross"><Wordmark /></div><span class="go">Zur App →</span></div>
        </a>
        <a class="zwei__h h-blog" href="/blog/" data-f="b">
          {neuester && <Image class="foto" src={neuester.data.aufmacher} alt="" widths={[700,1200]} sizes="60vw" format="avif" />}
          <div class="in"><p class="caps">Summits on the Air</p>
            <div class="gross">BLOG</div><span class="go">Zum Blog →</span></div>
        </a>
        <div class="naht mitte"></div>
      </div>
      <a class="band" href="/trainer/">
        <div class="band__in wrap">
          <div>
            <p class="caps">Im Browser, ohne Anmeldung</p>
            <h3>Contesttrainer</h3>
            <p class="band__text">Pile-Up, QSB, QRM und ein Wasserfall, der sich benimmt
              wie einer. SSB und CW, Schwierigkeit steigt mit dir.</p>
          </div>
          <span class="go">Üben →</span>
        </div>
      </a>
    </div>
  </section>

  <div class="wrap schluss">
    <p class="caps">Mein Rat</p>
    <h2>02, wenn der Trainer ein Werkzeug ist. 03, wenn er ein Angebot ist.</h2>
    <p>Der Unterschied ist nicht Gestaltung, sondern Anspruch. Bei 02 findet ihn, wer
      danach sucht. Bei 03 sieht ihn jeder, der die Seite öffnet. 01 würde ich nicht
      nehmen: die Startseite lebt davon, dass sie eine einzige Frage stellt.</p>
  </div>
</Base>

<style>
  .leiste { display:flex; align-items:center; gap:1rem; padding:.8rem var(--pad);
    background:linear-gradient(to bottom,var(--tile-top),var(--tile-mid) 55%,var(--tile-bot));
    border-bottom:1px solid var(--tile-line); }
  .leiste :global(.wm){ font-size:1.1rem; }
  .blatt{ border-top:1px solid var(--border-fine); }
  .kopf{ padding:2rem 0 1.2rem; display:flex; flex-direction:column; gap:.5rem; }
  .kopf h2{ font-size:1.6rem; }
  .kopf p{ margin:0; color:var(--t4); max-width:70ch; }
  .buehne{ position:relative; height:66svh; min-height:440px; overflow:hidden;
    border-block:1px solid var(--border-fine); background:var(--bg); }
  .buehne--hoch{ height:auto; min-height:0; }

  .in{ position:relative; z-index:3; display:flex; flex-direction:column; gap:.4rem; }
  .gross{ font-family:var(--ff-cond); font-weight:600; letter-spacing:.05em; line-height:1;
    color:var(--t1); font-size:clamp(1.6rem,4vw,3rem); }
  .gross :global(.wm){ font-size:inherit; }
  .foto, .buehne :global(canvas){ position:absolute; inset:0; width:100%; height:100%;
    object-fit:cover; z-index:0; }

  /* 01 — drei Streifen */
  .drei{ position:absolute; inset:0; }
  .drei__teil{ position:absolute; inset:0; display:flex; flex-direction:column;
    justify-content:flex-end; padding:var(--pad) var(--pad) 2rem;
    transition:clip-path .5s cubic-bezier(.22,.7,.3,1); }
  .drei__teil::after{ content:""; position:absolute; inset:0; z-index:1;
    background:linear-gradient(to bottom,rgba(8,8,10,.3),rgba(8,8,10,.9)); }
  .t-app    { clip-path:polygon(0 0,38% 0,26% 100%,0 100%); background:var(--bg); }
  .t-trainer{ clip-path:polygon(38% 0,70% 0,58% 100%,26% 100%); background:var(--panel); }
  .t-blog   { clip-path:polygon(70% 0,100% 0,100% 100%,58% 100%); background:var(--panel-2); }
  .naht{ position:absolute; z-index:4; top:-20%; width:1px; height:140%;
    background:linear-gradient(to bottom,transparent,var(--measured) 50%,transparent);
    box-shadow:0 0 0 1px rgba(8,8,10,.5),0 0 12px 2px rgba(194,146,79,.18);
    pointer-events:none; }
  .n1{ left:32%; transform:rotate(6.5deg); }
  .n2{ left:64%; transform:rotate(6.5deg); }

  /* 02 + 03 — zwei Haelften */
  .zwei{ position:absolute; inset:0; }
  .zwei.kurz{ position:relative; height:56svh; min-height:360px; }
  .zwei__h{ position:absolute; inset:0; display:flex; flex-direction:column;
    justify-content:flex-end; padding:var(--pad) var(--pad) 3.4rem; }
  .zwei__h::after{ content:""; position:absolute; inset:0; z-index:1; }
  .h-app{ clip-path:polygon(0 0,63% 0,37% 100%,0 100%); background:var(--bg); }
  .h-app::after{ background:linear-gradient(to bottom,rgba(8,8,10,.3),rgba(8,8,10,.9)); }
  .h-blog{ clip-path:polygon(63% 0,100% 0,100% 100%,37% 100%); background:var(--panel);
    align-items:flex-end; text-align:right; }
  .h-blog .in{ margin-left:auto; align-items:flex-end; }
  .h-blog::after{ background:linear-gradient(to bottom,rgba(8,8,10,.22) 0%,rgba(8,8,10,.16) 30%,rgba(8,8,10,.9) 100%); }
  .naht.mitte{ left:50%; transform:translateX(-50%) rotate(14.5deg); }

  .fuss{ position:absolute; z-index:5; left:0; right:0; bottom:0;
    display:flex; justify-content:space-between; align-items:center; gap:1rem;
    padding:.9rem var(--pad); background:linear-gradient(to top,rgba(8,8,10,.92),transparent);
    border-top:1px solid var(--border-fine); }
  .fuss__link{ color:var(--t3); border-bottom:1px solid var(--border);
    padding-bottom:.3rem; transition:color var(--ease),border-color var(--ease); }
  .fuss__link:hover{ color:var(--t1); border-color:var(--measured); }

  /* 03 — Band darunter */
  .band{ display:block; background:var(--panel); border-top:1px solid var(--border-fine); }
  .band__in{ display:flex; align-items:center; justify-content:space-between;
    gap:2rem; padding-block:clamp(1.6rem,4vh,2.6rem); flex-wrap:wrap; }
  .band h3{ font-family:var(--ff-cond); font-weight:600; font-size:clamp(1.5rem,3vw,2.2rem);
    letter-spacing:.04em; color:var(--t1); margin:.3rem 0; }
  .band__text{ margin:0; color:var(--t4); max-width:52ch; }
  .band:hover{ background:var(--panel-2); }

  .schluss{ padding-block:clamp(2.5rem,7vh,4rem); display:flex; flex-direction:column; gap:.6rem; }
  .schluss h2{ font-size:1.5rem; max-width:34ch; }
  .schluss p{ margin:0; color:var(--t4); max-width:66ch; }
</style>
