---
import Base from "../../../layouts/Base.astro";
import Wordmark from "../../../components/Wordmark.astro";
import Screens from "../../../components/Screens.astro";
import Vorfuehrung from "../../../components/Vorfuehrung.astro";
import Spektrum from "../../../components/Spektrum.astro";
import { longpathContent } from "../../../i18n/content/longpath";
import { DEFAULT_LOCALE, type Locale } from "../../../i18n/ui";

const lang = (Astro.currentLocale as Locale | undefined) ?? DEFAULT_LOCALE;
const c = longpathContent[lang];

/* Inhalte aus ../NereusSDR/README.md. Wenn dort eine Version steigt,
   gehoert sie hier mitgezogen — es gibt bisher keine Automatik dafuer. */
const VERSION = "0.6.0";
const DATUM = "29. August 2026";

const kette = c.kette.map((s, i) => ({ nr: String(i + 1).padStart(2, "0"), ...s }));
const hardware = c.hardware.map((h, i) => ({ ...h, ok: i < 3 }));

/* Was am Tisch sonst noch steht. Quellen: CHANGELOG.md und
   docs/architecture/ im Longpath-Baum. `neu: true` heisst: gebaut,
   aber noch nicht in einer Veroeffentlichung — steht im CHANGELOG
   unter [Unreleased]. */
const werkzeuge = c.werkzeuge.map((w) => ({ ...w, neu: true }));

const REL = `https://github.com/oe5sos/Longpath/releases/download/v${VERSION}`;
const RELTAG = `https://github.com/oe5sos/Longpath/releases/tag/v${VERSION}`;

const pakete = [
  {
    os: "macOS · Apple Silicon", datei: "DMG · PKG · firmado con GPG", empfohlen: true,
    links: [
      { label: "DMG", href: `${REL}/Longpath-${VERSION}-macOS-apple-silicon.dmg` },
      { label: "PKG", href: `${REL}/Longpath-${VERSION}-macOS-apple-silicon.pkg` },
    ],
  },
  {
    os: "macOS · Intel", datei: "DMG · PKG · firmado con GPG", empfohlen: false,
    links: [
      { label: "DMG", href: `${REL}/Longpath-${VERSION}-macOS-intel.dmg` },
      { label: "PKG", href: `${REL}/Longpath-${VERSION}-macOS-intel.pkg` },
    ],
  },
  {
    os: "Linux", datei: "AppImage · x86_64 + aarch64", empfohlen: false,
    links: [
      { label: "x86_64", href: `${REL}/Longpath-${VERSION}-x86_64.AppImage` },
      { label: "aarch64", href: `${REL}/Longpath-${VERSION}-aarch64.AppImage` },
    ],
  },
  {
    os: "Windows", datei: "Instalador NSIS · ZIP portable · x64", empfohlen: false,
    links: [
      { label: "Instalador", href: `${REL}/Longpath-${VERSION}-Windows-x64-setup.exe` },
      { label: "ZIP", href: `${REL}/Longpath-${VERSION}-Windows-x64-portable.zip` },
    ],
  },
  {
    os: c.download.alleAlternativ, datei: "SHA256SUMS.txt · firmado con GPG", empfohlen: false,
    links: [{ label: c.download.alleAlternativ, href: RELTAG }],
  },
];
---

<Base
  titel={c.meta.titel}
  beschreibung={c.meta.beschreibung}
  raum="app"
>
  <header class="hero">
    <Spektrum art="band" grundlinie={0.74} />
    <div class="hero__in">
      <p class="caps">{c.hero.versionZeile.replace("{v}", VERSION)}</p>
      <div class="hero__wm"><Wordmark /></div>
      <h1>{c.hero.h1}</h1>
      <p class="hero__sub" set:html={c.hero.subHtml} />
      <div class="cta">
        <a class="btn" href="#download">{c.hero.ctaDownload}</a>
        <a class="btn btn--quiet" href="#signalkette">{c.hero.ctaSignalkette}</a>
      </div>
    </div>
    <div class="readout">
      <div class="readout__grid wrap">
        <div class="readout__cell"><span class="caps">{c.hero.readout.version}</span><span class="readout__v">{VERSION}</span></div>
        <div class="readout__cell"><span class="caps">{c.hero.readout.protokolle}</span><span class="readout__v">P1 + P2</span></div>
        <div class="readout__cell"><span class="caps">{c.hero.readout.bandbreite}</span><span class="readout__v">1 536 kHz</span></div>
        <div class="readout__cell"><span class="caps">{c.hero.readout.dsp}</span><span class="readout__v">WDSP</span></div>
        <div class="readout__cell"><span class="caps">{c.hero.readout.pakete}</span><span class="readout__v">5</span></div>
      </div>
    </div>
  </header>

  <main>
    <section class="section wrap" id="signalkette">
      <div class="section__head">
        <p class="caps">{c.signalkette.kicker}</p>
        <h2>{c.signalkette.h2}</h2>
      </div>
      <div class="kette">
        {kette.map((s) => (
          <article class="stufe">
            <div class="stufe__nr"><span class="caps num">{s.nr} — {s.stufe}</span></div>
            <div class="stufe__text">
              <h3>{s.titel}</h3>
              <p>{s.text}</p>
              <div class="marken">{s.marken.map((m) => <span class="marke">{m}</span>)}</div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section wrap" id="werkzeuge">
      <div class="section__head">
        <p class="caps">{c.werkzeugeKopf.kicker}</p>
        <h2>{c.werkzeugeKopf.h2}</h2>
        <p class="intro" set:html={c.werkzeugeKopf.introHtml.replace("{v}", VERSION)} />
      </div>

      <div class="werk">
        {werkzeuge.map((w) => (
          <article class="panel werk__karte">
            <div class="panel__head">
              <span class="caps num">{w.bereich}</span>
              {w.neu && <span class="werk__neu caps">{c.werkzeugeKopf.imBau}</span>}
            </div>
            <div class="werk__body">
              <h3>{w.titel}</h3>
              <p>{w.text}</p>
              <div class="marken">{w.marken.map((m) => <span class="marke">{m}</span>)}</div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section wrap" id="hardware">
      <div class="section__head">
        <p class="caps">{c.hardwareKopf.kicker}</p>
        <h2>{c.hardwareKopf.h2}</h2>
      </div>
      <div class="hw">
        {hardware.map((h) => (
          <article class="panel karte">
            <div class="panel__head"><span class="caps num">{h.protokoll}</span></div>
            <div class="karte__body">
              <h3>{h.titel}</h3>
              <p>{h.text}</p>
              <span class:list={["kapsel", h.ok ? "kapsel--ok" : "kapsel--rx"]}>
                <span class="punkt"></span>{h.stand}
              </span>
            </div>
          </article>
        ))}
      </div>
    </section>

    <Screens />

    <Vorfuehrung
      quelle="/video/longpath-vorfuehrung.mp4"
      standbild="/video/longpath-vorfuehrung.jpg"
      breite={1470}
      hoehe={956}
      dauer="2:30"
      auge={c.vorfuehrung.auge}
      titel={c.vorfuehrung.titel}
      vorspann={c.vorfuehrung.vorspann}
    />

    <section class="section wrap" id="sunsdr">
      <div class="section__head">
        <p class="caps">{c.sunsdr.kicker}</p>
        <h2>{c.sunsdr.h2}</h2>
      </div>

      <div class="sun">
        <div class="sun__text">
          <p set:html={c.sunsdr.p1Html} />
          <p set:html={c.sunsdr.p2Html} />
          <p set:html={c.sunsdr.p3Html} />
        </div>

        <div class="panel sun__panel">
          <div class="panel__head"><span class="caps">{c.sunsdr.wegHinein}</span></div>
          <ol class="schritte">
            {c.sunsdr.schritte.map((s, i) => {
              const [kopf, ...rest] = s.split(" — ");
              return (
                <li>
                  <span class="caps num">{String(i + 1).padStart(2, "0")}</span>
                  <span>{kopf} — {i === 0 ? <code>{rest.join(" — ")}</code> : rest.join(" — ")}</span>
                </li>
              );
            })}
          </ol>
          <div class="sun__stand">
            <span class="kapsel kapsel--ok"><span class="punkt"></span>{c.sunsdr.verifiziert}</span>
            <span class="caps num">24.08.2026 · OE5SOS</span>
          </div>
        </div>
      </div>

      <p class="herkunft" style="margin-top:2rem" set:html={c.sunsdr.grenzeHtml} />
    </section>

    <section class="section wrap" id="download">
      <div class="section__head">
        <p class="caps">{c.download.kicker}</p>
        <h2>{c.download.h2}</h2>
        <p class="intro" set:html={c.download.introHtml} />
      </div>
      <div class="panel dl">
        <div class="panel__head dl__head">
          <span class="caps">{c.download.kanalKopf}</span>
          <span class="caps num caps--m">v{VERSION} — {DATUM}</span>
        </div>
        <div class="dl__body">
          {pakete.map((p) => (
            <div class:list={["dl__item", p.empfohlen && "dl__item--rec"]}>
              <p class:list={["caps", p.empfohlen && "caps--m"]}>
                {p.empfohlen ? c.download.fuerDieses : " "}
              </p>
              <span class="dl__os">{p.os}</span>
              <span class="dl__datei">{p.datei}</span>
              <span class="dl__stand caps">
                <span class="punkt"></span>{c.download.stand}
              </span>
              <span class="dl__links">
                {p.links.map((l, i) => (
                  <>
                    {i > 0 && <span class="dl__sep">·</span>}
                    <a class="dl__link" href={l.href}>{c.download.herunterladen}{p.links.length > 1 ? ` (${l.label})` : ""}</a>
                  </>
                ))}
              </span>
            </div>
          ))}
        </div>
      </div>

      <p class="herkunft" set:html={c.download.herkunftHtml} />
    </section>
  </main>
</Base>

<style>
  .hero { position: relative; overflow: hidden; border-bottom: 1px solid var(--border-fine); }
  /* Der Schleier liegt zwischen Zeichnung und Schrift. Oben dunkler,
     damit die Leiste sich nicht auf dem Wasserfall abzeichnet; unten
     fast deckend, damit das Ablesegitter ruhig steht. */
  .hero::after {
    content: ""; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(to bottom,
      rgba(8,8,10,.74) 0%, rgba(8,8,10,.44) 40%, rgba(8,8,10,.9) 100%);
  }
  .hero .readout { position: relative; z-index: 2; }
  .hero__in {
    position: relative; z-index: 2;
    max-width: var(--maxw); margin: 0 auto;
    padding: clamp(4rem, 13vh, 8rem) var(--pad) clamp(2.5rem, 7vh, 4.5rem);
    display: flex; flex-direction: column; gap: 1.2rem; align-items: flex-start;
  }
  .hero__wm :global(.wm) { font-size: clamp(3rem, 9.5vw, 7rem); }
  .hero h1 {
    font-size: clamp(1.6rem, 3.6vw, 2.6rem); font-weight: 500;
    color: var(--t2); max-width: 24ch; margin-top: .3rem;
  }
  .hero__sub { max-width: 52ch; margin: 0; font-size: clamp(1rem, 1.8vw, 1.18rem); color: var(--t4); }
  .hero__sub em { color: var(--t2); font-style: normal; }
  .cta { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: .5rem; }

  .readout { border-top: 1px solid var(--border-fine); background: rgba(12,12,14,.72); }
  .readout__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(132px, 1fr)); }
  .readout__cell {
    padding: .95rem 0 .95rem 1.1rem; display: flex; flex-direction: column; gap: .3rem;
    border-left: 1px solid var(--border-fine);
  }
  .readout__cell:first-child { border-left: 0; padding-left: 0; }
  .readout__v { font-family: var(--ff-mono); font-size: .98rem; color: var(--measured-hi); font-variant-numeric: tabular-nums; }
  @media (max-width: 640px) { .readout__cell { border-left: 0; padding-left: 0; } }

  .section { padding-block: clamp(3.5rem, 10vh, 7rem); }
  .section__head { display: flex; flex-direction: column; gap: .8rem; margin-bottom: clamp(2rem, 5vh, 3.2rem); }
  .section__head h2 { font-size: clamp(1.7rem, 3.6vw, 2.6rem); max-width: 22ch; }

  .kette { display: flex; flex-direction: column; }
  .stufe {
    display: grid; grid-template-columns: 6.5rem 1fr; gap: clamp(1rem, 4vw, 2.8rem);
    padding-block: clamp(1.6rem, 3.6vh, 2.5rem);
    border-top: 1px solid var(--border-fine); align-items: start;
  }
  .stufe:last-child { border-bottom: 1px solid var(--border-fine); }
  .stufe__nr { padding-top: .4rem; }
  .stufe__text { display: flex; flex-direction: column; gap: .5rem; }
  .stufe__text h3 { font-size: clamp(1.25rem, 2.4vw, 1.6rem); font-weight: 500; }
  .stufe__text p { margin: 0; color: var(--t4); max-width: 60ch; }
  .marken { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: .3rem; }
  .marke {
    font-family: var(--ff-mono); font-size: 9px; letter-spacing: .14em; text-transform: uppercase;
    color: var(--t5); background: var(--btn); border: 1px solid var(--border-fine);
    border-radius: var(--radius-s); padding: .3rem .55rem;
  }
  @media (max-width: 560px) { .stufe { grid-template-columns: 1fr; gap: .45rem; } .stufe__nr { padding-top: 0; } }

  .werk { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1rem; }
  .werk__karte { display: flex; flex-direction: column; }
  .werk__karte .panel__head { justify-content: space-between; }
  .werk__neu {
    color: var(--measured); border: 1px solid var(--measured-border, #6b5426);
    background: var(--measured-bg, #33280f); border-radius: var(--radius-s);
    padding: .2rem .45rem; flex-shrink: 0;
  }
  .werk__body { padding: 1.1rem .9rem 1rem; display: flex; flex-direction: column; gap: .6rem; flex: 1; }
  .werk__body h3 { font-size: 1.12rem; font-weight: 500; }
  .werk__body p { margin: 0; font-size: .95rem; color: var(--t4); }
  .werk__body .marken { margin-top: auto; padding-top: .6rem; }

  .section__head .intro { margin: 0; color: var(--t4); max-width: 60ch; }
  .section__head .intro em { color: var(--measured); font-style: normal; }

  .hw { display: grid; grid-template-columns: repeat(auto-fit, minmax(255px, 1fr)); gap: 1rem; }
  .karte { display: flex; flex-direction: column; }
  .karte__body { padding: 1.1rem .9rem 1rem; display: flex; flex-direction: column; gap: .5rem; flex: 1; }
  .karte__body h3 { font-size: 1.1rem; font-weight: 500; }
  .karte__body p { margin: 0; font-size: .95rem; color: var(--t4); }
  /* Regel 5 — Zustand als umrandete Kapsel, immer an derselben Stelle */
  .kapsel {
    margin-top: auto; align-self: flex-start;
    display: inline-flex; align-items: center; gap: .45rem;
    font-family: var(--ff-mono); font-size: 9px; letter-spacing: .16em; text-transform: uppercase;
    border-radius: var(--radius-s); padding: .32rem .6rem; border: 1px solid;
  }
  .kapsel--ok { color: var(--ok); border-color: var(--ok-border); background: var(--ok-bg); }
  .kapsel--rx { color: var(--t3); border-color: var(--border-2); background: var(--btn); }
  .punkt { width: 5px; height: 5px; border-radius: 50%; background: currentColor; flex-shrink: 0; }

  .dl__head { height: auto; min-height: 34px; padding: .5rem 1rem; display: flex; justify-content: space-between; flex-wrap: wrap; gap: .8rem; }
  .dl__body { display: grid; grid-template-columns: repeat(auto-fit, minmax(215px, 1fr)); }
  .dl__item { padding: 1.2rem 1.1rem; display: flex; flex-direction: column; gap: .35rem; border-left: 1px solid var(--border-fine); }
  .dl__item:first-child { border-left: 0; }
  .dl__item--rec { background: var(--panel-2); }
  .dl__os { font-family: var(--ff-cond); font-weight: 500; font-size: 1.18rem; color: var(--t1); }
  .dl__datei { font-family: var(--ff-mono); font-size: 10px; letter-spacing: .06em; color: var(--t5); word-break: break-word; }
  .dl__stand {
    margin-top: .5rem; align-self: flex-start;
    display: inline-flex; align-items: center; gap: .45rem;
    color: var(--t5); background: var(--btn);
    border: 1px solid var(--border-fine); border-radius: var(--radius-s);
    padding: .32rem .6rem;
  }
  .dl__stand .punkt { background: var(--t6); }

  .dl__links {
    margin-top: .5rem; display: flex; flex-wrap: wrap; align-items: baseline; gap: .5rem;
  }
  .dl__link {
    font-family: var(--ff-mono); font-size: 9px; letter-spacing: .18em; text-transform: uppercase;
    color: var(--t3); border-bottom: 1px solid var(--border); padding-bottom: .25rem;
    transition: color var(--ease), border-color var(--ease);
  }
  .dl__link:hover { color: var(--t1); border-color: var(--border-2); }
  .dl__sep { color: var(--t6); font-size: 9px; }
  @media (max-width: 700px) {
    .dl__item { border-left: 0; border-top: 1px solid var(--border-fine); }
    .dl__item:first-child { border-top: 0; }
  }

  .sun { display: grid; grid-template-columns: 1.5fr 1fr; gap: clamp(1.5rem, 4vw, 3rem); align-items: start; }
  .sun__text p { margin: 0 0 1.2em; color: var(--t4); max-width: 62ch; }
  .sun__text strong { color: var(--t2); font-weight: 500; }
  .sun__text em { color: var(--t2); font-style: normal; }
  .sun__panel { position: sticky; top: 4.5rem; }
  .schritte { list-style: none; margin: 0; padding: 0; }
  .schritte li {
    display: flex; align-items: baseline; gap: .9rem;
    padding: .8rem .9rem; border-bottom: 1px solid var(--border-fine); color: var(--t3);
  }
  .schritte li:last-child { border-bottom: 0; }
  .schritte code {
    font-family: var(--ff-mono); font-size: .82em; color: var(--measured-hi);
  }
  .sun__stand {
    display: flex; flex-wrap: wrap; align-items: center; gap: .7rem;
    padding: .8rem .9rem; border-top: 1px solid var(--border-fine); background: var(--panel-2);
  }
  @media (max-width: 820px) {
    .sun { grid-template-columns: 1fr; }
    .sun__panel { position: static; }
  }

  .herkunft {
    margin-top: 2.2rem; font-size: .95rem; color: var(--t5); max-width: 66ch;
    border-left: 1px solid var(--border); padding-left: 1.1rem;
  }
  .herkunft strong { color: var(--t4); font-weight: 400; }
</style>
