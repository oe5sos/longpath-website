---
/**
 * Die Seite des Contestprogramms.
 *
 * Ein Geschwister von Longpath, kein Teil davon: ein eigenes Programm
 * fuer den 24-Stunden-Contest auf 2 m und 70 cm. Was hier steht,
 * stuetzt sich auf den Quellbaum unter ../Contestprogramm/ — jede
 * Aussage hat dort eine Klasse. Seit 0.1.0 (21. September 2026) gibt
 * es ein Paket fuer macOS und den Quelltext auf GitHub; Windows und
 * Linux folgen ueber die CI.
 */
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import arbeitsplatz from "../../assets/contest/01-arbeitsplatz.png";
import karte from "../../assets/contest/02-karte.png";
import rotoren from "../../assets/contest/03-rotoren.png";

const STAND = "21. September 2026";
const VERSION = "0.1.1";
const GITHUB = "https://github.com/oe5sos/Contestprogramm";
const REL = `${GITHUB}/releases/download/v${VERSION}`;
const RELTAG = `${GITHUB}/releases/tag/v${VERSION}`;

/* Die Pakete — dieselbe Tafel wie auf der App-Seite. Windows und Linux
   sind Qt-Baeume wie macOS auch, nur baut sie noch niemand: die CI dafuer
   ist die naechste Arbeit, die Zeilen stehen schon. */
const pakete = [
  {
    os: "macOS · Apple Silicon", datei: `Contestprogramm-${VERSION}-macOS-apple-silicon.dmg · SHA256`, empfohlen: true, da: true,
    links: [
      { label: "DMG", href: `${REL}/Contestprogramm-${VERSION}-macOS-apple-silicon.dmg` },
      { label: "SHA256", href: `${REL}/Contestprogramm-${VERSION}-macOS-apple-silicon.dmg.sha256` },
    ],
  },
  {
    os: "Windows · x64", datei: `Contestprogramm-${VERSION}-Windows-x64-portable.zip · SHA256`, empfohlen: false, da: true,
    stand: "Gebaut · ungeprüft",
    links: [
      { label: "ZIP", href: `${REL}/Contestprogramm-${VERSION}-Windows-x64-portable.zip` },
      { label: "SHA256", href: `${REL}/Contestprogramm-${VERSION}-Windows-x64-portable.zip.sha256` },
    ],
  },
  {
    os: "Linux · x86_64", datei: `Contestprogramm-${VERSION}-x86_64.AppImage · SHA256`, empfohlen: false, da: true,
    stand: "Gebaut · ungeprüft",
    links: [
      { label: "AppImage", href: `${REL}/Contestprogramm-${VERSION}-x86_64.AppImage` },
      { label: "SHA256", href: `${REL}/Contestprogramm-${VERSION}-x86_64.AppImage.sha256` },
    ],
  },
  {
    os: "Quelltext", datei: "GitHub · GPL-3.0-or-later", empfohlen: false, da: true,
    links: [{ label: "GitHub", href: GITHUB }, { label: "Release", href: RELTAG }],
  },
];

/* Was das Programm kann — je Karte eine Gruppe von Klassen im Quellbaum. */
const werke = [
  {
    bereich: "Log",
    titel: "Ein Log, das beim Tippen schon prüft.",
    text: "SQLite unter dem Tisch, Dupe-Prüfung bei jedem Tastendruck — und wenn es ein Dupe ist, steht sofort da, als welche Nummer und um wie viel Uhr die Station schon im Log ist. Die Austauschfelder (RST, laufende Nummer je Band ab 001, Locator) kommen aus der Contest-Definition. Ein Locator, den man schon einmal gehört hat, steht von selbst da; geloggte Zeilen lassen sich in der Zeile berichtigen, statt Löschen gibt es „ungültig“.",
    marken: ["SQLite", "Dupe-Check", "Locator-Autofill", "Korrektur in der Zeile"],
  },
  {
    bereich: "ON4KST · DX-Cluster",
    titel: "Zwei Feeds, beide gefiltert.",
    text: "Der ON4KST-Chat und ein klassischer DX-Cluster laufen als zwei getrennte Listen. Was außer Reichweite ist oder schon gearbeitet wurde, verschwindet; ein Schalter zeigt bei Bedarf die Rohdaten. Wie streng gefiltert wird, hängt von der eigenen Rate ab — im Pile-Up bleibt nur das Wichtigste stehen, in der Flaute fast alles.",
    marken: ["Telnet", "Geo-Filter", "Adaptive Schwelle"],
  },
  {
    bereich: "Betriebsassistent",
    titel: "Ein Vorschlag, nie ein Automat.",
    text: "Aus allen sichtbaren Kandidaten wird der eine mit der besten Aussicht gewählt — Erreichbarkeit, Neuheit, Multiplikatorwert, Aktualität, dazu ein kleiner Bonus für Richtungen, in denen gerade ein QSO gelang. Die Chat-Nachricht dazu ist vorformuliert. Gesendet wird sie erst nach einem Klick; der Assistent selbst hat keinen Weg zum Netz.",
    marken: ["Nächstes Ziel", "Nachricht auf Klick"],
  },
  {
    bereich: "Karte · Verbindungen",
    titel: "Ein Radar um den eigenen Standort.",
    text: "Eine Scheibe mit Entfernungsringen und Peilung, gearbeitete Stationen als Punkte, offene Spots als Ringe, jeder Rotor als Lichtkegel in seiner Richtung, der Horizont aus dem Gelände als dunkler Rand. Staatsgrenzen, Städte und Locator-Raster (Natural Earth) lassen sich dazuschalten. Ein Klick auf eine Station stellt Frequenz und Rotor; ein Klick auf „Offen in Richtung“ funkt die nächste offene Station im Beam an.",
    marken: ["Radar", "Rotor-Kegel", "Horizont", "Klick = QSY + Rotor"],
  },
  {
    bereich: "Rotoren",
    titel: "Zwei Kompasse, ein rotctld.",
    text: "Zwei Rotoren nebeneinander, jeder mit Öffnungswinkel als Kegel, Ist- und Sollwert in Glaszellen, kurzer und langer Weg; eine zweite Antenne am selben Rotor hat ihre eigene Nadel. Angesteuert über Hamlibs rotctld, das das Programm selbst startet und überwacht; fehlt Hamlib, wird die Installation angeboten. Sektoren, in denen das Gelände im Nahfeld verdeckt, liegen als Waschung auf dem Ring. Wird das Panel klein, weicht erst die Ablesung, dann der Rand — die Skala bleibt.",
    marken: ["rotctld", "GS-232", "Kegel", "Gelände am Ring"],
  },
  {
    bereich: "Gelände",
    titel: "Sichtlinie mit echtem Höhenmodell.",
    text: "SRTM1-Kacheln mit 30 m Auflösung werden bei Bedarf geladen und bleiben auf der Platte. Jeder Pfad wird gegen das Gelände gerechnet — mit 4/3-Erdradius und der 60-Prozent-Fresnel-Regel: frei, grenzwertig oder verdeckt. Für die Standortsuche vor dem Contest gibt es den Rundum-Horizont: 360 Grad um einen Kandidatenstandort, zum Vergleichen.",
    marken: ["SRTM1", "Fresnel-Zone", "Standortvergleich"],
  },
  {
    bereich: "Multiplikatoren · Rate",
    titel: "Was fehlt, je Band.",
    text: "Gearbeitete und noch offene Großfelder je Band in einer sortierbaren Tabelle; dieselben Daten heben im Feed die Kandidaten an, die einen neuen Multiplikator bringen. Die Rate ist ein Instrument, das der Panelgröße folgt: niedrig und breit als Leiste mit Balken je Band und Sparkline der letzten sechs Stunden, sonst als Kacheln — QSOs, Punkte, zehn Minuten, Stunde, ODX, Felder.",
    marken: ["Worked / Needed", "10 min · 1 h · beste Stunde", "ODX"],
  },
  {
    bereich: "CAT · CW",
    titel: "Frequenz vom Gerät, Makros ans Gerät.",
    text: "Der klassische Transceiver hängt über Hamlibs rigctld am Programm: Frequenz und Betriebsart laufen ins Log, das Band ergibt sich daraus — auch über einen Transverter, dessen Offset das Programm kennt. CW-Makros auf F1–F6 setzen Rufzeichen und Austausch ein; ESM lässt Enter senden, was der QSO-Stand gerade verlangt, und loggt am Ende.",
    marken: ["rigctld", "Transverter", "F-Tasten", "ESM"],
  },
  {
    bereich: "Contest · Export",
    titel: "Regeln als Datei, Log als EDI.",
    text: "Jeder Contest ist eine Definition: Bänder, Austauschfelder, Wertung in Kilometern, Dupe-Regel, Zeitfenster — als Datei, im Programm nachbearbeitbar. IARU Region 1 (VHF, UHF/Mikrowelle, Marconi) und ÖVSV sind dabei. Am Ende: EDI/REG1TEST je Band für den Roboter, Cabrillo und ADIF dazu; „Log prüfen“ sagt vorher, was der Auswerter beanstanden würde. Online-Scoreboard und N1MM-UDP für Werkzeuge, die zuhören.",
    marken: ["EDI / REG1TEST", "Cabrillo", "ADIF", "Log prüfen"],
  },
  {
    bereich: "Arbeitsplatz",
    titel: "Panels, die man verschieben und sperren kann.",
    text: "Jedes Panel lässt sich ziehen, in der Größe ändern und mit dem Schloss festhalten; Layouts liegen als Profile in der Schiene links, eines je Aufgabe, dazu eine kompakte Anordnung für ein 13-Zoll-Notebook. Oben die UTC-Uhr mit dem Countdown bis zum Contest-Ende, unten Wetter vom Standort. Zwei Farbthemen: Bernstein und Grün.",
    marken: ["Layout-Profile", "UTC-Countdown", "Wetter", "Bernstein · Grün"],
  },
  {
    bereich: "Startcheck · Sicherung",
    titel: "Vor dem ersten CQ alles auf einen Blick.",
    text: "Der Startcheck prüft Station, Contest, Verbindungen und Daten, bevor es losgeht: Rufzeichen, ob der exakte Standort im Locator liegt, die Uhrzeit gegen das Netz, CAT, beide Rotoren, ON4KST, die Sicherung. Das Log sichert sich jede Minute in eine Kopie, auf Wunsch zusätzlich auf einen Stick — und lässt sich auf jeden Stand zurücksetzen.",
    marken: ["Startcheck", "Uhrzeit", "Sicherung jede Minute"],
  },
  {
    bereich: "Bandmap · Skeds · Check",
    titel: "Was auf dem Band los ist, und wer wann wartet.",
    text: "Spots aus KST und Cluster auf der Frequenzachse, gearbeitete gedimmt, Klick ist QSY. Skeds mit Zeitleiste der nächsten Stunde, aus einer KST-Nachricht mit einem Klick angelegt. Check Partial schlägt beim Tippen Rufzeichen aus Log, Locator-Liste und gehörten Stationen vor.",
    marken: ["Bandmap", "Skeds", "Check Partial"],
  },
];

/* Was aus Longpath uebernommen wurde — die Herkunftszeile unten. */
const uebernommen = [
  "Locator-Geometrie (Maidenhead, Entfernung, Peilung)",
  "DX-Cluster-Client und rotctld-Anbindung",
  "Panel-Chrom, Layout-Profile und Profilschiene",
  "Kurz- und Langweg-Rechnung für den Rotor",
];
---

<Base
  titel="Contestprogramm — Longpath"
  beschreibung="Contestprogramm: ein Logger für den 24-Stunden-Contest auf 2 m und 70 cm. Log, ON4KST-Chat, DX-Cluster, Radar, zwei Rotoren und echtes Gelände — Version 0.1.0 für macOS, Quelltext auf GitHub."
  raum="contest"
>
  <header class="hero">
    <div class="hero__in">
      <p class="caps">VHF/UHF · 144 + 432 MHz · 24 Stunden</p>
      <div class="hero__wm">CONTEST<span class="hero__wm2">PROGRAMM</span></div>
      <h1>Ein Logger für den Contest am Berg.</h1>
      <p class="hero__sub">
        Log, ON4KST-Chat, DX-Cluster, Karte und zwei Rotoren auf einem Bildschirm —
        gebaut für einen Bergstandort wie den Feuerkogel, mit <em>echtem Gelände</em>
        in jeder Entscheidung. Qt 6, ein eigenes Programm neben Longpath.
      </p>
      <div class="cta">
        <a class="btn" href="#download">Herunterladen · {VERSION}</a>
        <a class="btn btn--quiet" href={GITHUB}>Quelltext auf GitHub</a>
        <a class="btn btn--quiet" href="#log">Was es kann</a>
      </div>
    </div>
    <div class="readout">
      <div class="readout__grid wrap">
        <div class="readout__cell"><span class="caps">Bänder</span><span class="readout__v">2 m + 70 cm</span></div>
        <div class="readout__cell"><span class="caps">Contests</span><span class="readout__v">UKW</span></div>
        <div class="readout__cell"><span class="caps">CAT · Rotor</span><span class="readout__v">Hamlib</span></div>
        <div class="readout__cell"><span class="caps">Gelände</span><span class="readout__v">SRTM1 · 30 m</span></div>
        <div class="readout__cell"><span class="caps">Export</span><span class="readout__v">EDI · Cabrillo · ADIF</span></div>
        <div class="readout__cell"><span class="caps">Version</span><span class="readout__v">{VERSION} · GPLv3</span></div>
      </div>
    </div>
  </header>

  <main>
    <section class="section wrap" id="log">
      <div class="section__head">
        <p class="caps">Der Arbeitsplatz</p>
        <h2>Alles, was im Contest zählt, auf einem Bildschirm.</h2>
        <p class="intro">
          Links das Log mit der Eingabezeile und dem Chat an ON4KST, darunter der
          Vorschlag für das nächste Ziel und die Rate. Rechts die Karte um den
          eigenen Standort und die beiden Rotoren. Jedes Panel lässt sich verschieben,
          jedes Layout als Profil ablegen.
        </p>
      </div>
      <figure class="schirm">
        <div class="schirm__rahmen">
          <Image src={arbeitsplatz} alt="Contestprogramm: Log, Karte, Rotoren, Nächstes Ziel und Rate in einem Fenster"
            widths={[720, 1200, 1800]} sizes="(max-width: 900px) 100vw, 1100px" loading="eager" format="webp" quality={92} />
        </div>
        <figcaption>
          <span class="caps num">01 — Profil 1</span>
          <h3>Log, Karte, Rotoren, nächstes Ziel, Rate.</h3>
          <p>IARU Region 1 VHF/UHF, zwölf QSOs im Testlog, beide Rotoren auf ihrem Ziel. Die kompakte Anordnung, wie sie ein frischer Start auf einem 13-Zoll-Notebook wählt. Unten die Statusleiste: CAT, ON4KST, Cluster, Locator, Radius und das Wetter vom Standort.</p>
        </figcaption>
      </figure>
    </section>

    <section class="section wrap" id="werke">
      <div class="section__head">
        <p class="caps">Was es kann</p>
        <h2>Zwölf Dinge, die im Contest einen Unterschied machen.</h2>
      </div>
      <div class="werk">
        {werke.map((w) => (
          <article class="panel werk__karte">
            <div class="panel__head"><span class="caps num">{w.bereich}</span></div>
            <div class="werk__body">
              <h3>{w.titel}</h3>
              <p>{w.text}</p>
              <div class="marken">{w.marken.map((m) => <span class="marke">{m}</span>)}</div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section wrap" id="karte">
      <div class="section__head">
        <p class="caps">Die Karte</p>
        <h2>Fünfhundert Kilometer um den eigenen Locator, als Radar.</h2>
        <p class="intro">
          Entfernungsringe und Peilung, grün die gearbeiteten Stationen, in Bernstein
          der eigene Standort. Die beiden Kegel sind die Rotoren — 2 m auf 328°, 70 cm
          auf 16°, jeder so breit wie die Antenne öffnet. Grenzen und Städte aus
          Natural Earth sind hier dazugeschaltet; der Rand aus dem Gelände zeigt, wo
          die Berge verdecken.
        </p>
      </div>
      <figure class="schirm">
        <div class="schirm__rahmen">
          <Image src={karte} alt="Radar um JN67: Entfernungsringe, gearbeitete Stationen, beide Rotoren als Kegel, Staatsgrenzen und Städte"
            widths={[720, 1200, 1800]} sizes="(max-width: 900px) 100vw, 1100px" loading="lazy" format="webp" quality={92} />
        </div>
        <figcaption>
          <span class="caps num">02 — Profil 2</span>
          <h3>Das Radar allein, bildschirmfüllend.</h3>
          <p>Ein zweites Layout-Profil aus der Schiene links: nur das Radar. Jede Ebene — Ringe, Peilung, Horizont, Rotor 1, Rotor 2, Zweitantenne, Grenzen, Städte, Raster, gearbeitete Felder — sitzt im ⚙-Menü rechts oben im Panelkopf und bleibt gespeichert.</p>
        </figcaption>
      </figure>
    </section>

    <section class="section wrap" id="rotoren">
      <div class="section__head">
        <p class="caps">Die Rotoren</p>
        <h2>Zwei Antennen, zwei Richtungen, ein Blick.</h2>
        <p class="intro">
          Jeder Kompass zeigt Ist und Soll, den Öffnungswinkel als Kegel, den kurzen
          und den langen Weg. Die Zahlen darunter sind gemessen, nicht gerechnet —
          Bernstein für den Istwert, Blau für das Ziel, das sich auch von Hand eintippen
          lässt. Die Ansteuerung geht über rotctld; das Programm startet es selbst.
        </p>
      </div>
      <figure class="schirm">
        <div class="schirm__rahmen">
          <Image src={rotoren} alt="Zwei Rotor-Kompasse mit Kegel, Ist- und Sollwert in Glaszellen"
            widths={[720, 1200, 1800]} sizes="(max-width: 900px) 100vw, 1100px" loading="lazy" format="webp" quality={92} />
        </div>
        <figcaption>
          <span class="caps num">03 — Profil 3</span>
          <h3>Zwei Rotoren, beide auf dem Weg zum Ziel.</h3>
          <p>Links 2 m auf 328° unterwegs nach 296° zu DL1ABC, rechts 70 cm auf 16° nach 47° zu OK2A — dort mit einer zweiten Antenne 45° daneben, die Ziffern am Ring markieren die beiden. Aktuell, Ziel und Entfernung stehen in Glaszellen darunter, sobald der Rotor verbunden ist.</p>
        </figcaption>
      </figure>
    </section>

    <section class="section wrap" id="herkunft">
      <div class="section__head">
        <p class="caps">Herkunft</p>
        <h2>Ein Geschwister von Longpath, kein Teil davon.</h2>
      </div>
      <div class="sun">
        <div class="sun__text">
          <p>
            Das Contestprogramm ist am 9. September 2026 aus einer beiläufigen Frage
            zu ON4KST entstanden und in einer Woche zu dem geworden, was hier steht.
            Es ist ein <strong>eigenes Programm</strong> mit eigenem Quellbaum — nicht
            in Longpath eingebaut und nicht davon abhängig. Am Funkgerät hängt es über
            Hamlib, nicht über einen SDR.
          </p>
          <p>
            Was sich in Longpath bewährt hat, wurde übernommen, mit Quellenangabe in
            jeder Datei. Was ein Contest anders braucht, wurde neu gebaut: der
            ON4KST-Anmeldeautomat, die Dupe-Prüfung pro Tastendruck, der Assistent,
            die Karte, das Gelände.
          </p>
          <p>
            <strong>Stand {STAND}:</strong> Version {VERSION} gibt es als Paket für
            macOS (Apple Silicon), Windows und Linux, dazu der Quelltext unter
            GPL-3.0-or-later auf GitHub; spätere Versionen holt sich das Programm über
            <em>Hilfe › Auf neueste Version aktualisieren</em> selbst. Gegen den echten
            ON4KST-Server ist es gelaufen, gegen Transceiver und Rotor am Tisch; der
            erste Contest damit ist der IARU-Region-1-UHF/Mikrowellen-Contest Anfang
            Oktober.
          </p>
        </div>
        <div class="panel sun__panel">
          <div class="panel__head"><span class="caps">Aus Longpath übernommen</span></div>
          <ol class="schritte">
            {uebernommen.map((u, i) => (
              <li><span class="caps num">{String(i + 1).padStart(2, "0")}</span><span>{u}</span></li>
            ))}
          </ol>
          <div class="sun__stand">
            <span class="kapsel kapsel--bau"><span class="punkt"></span>Version {VERSION}</span>
            <span class="caps num">{STAND} · OE5SOS</span>
          </div>
        </div>
      </div>
    </section>

    <section class="section wrap" id="download">
      <div class="section__head">
        <p class="caps">Download</p>
        <h2>Version {VERSION} — macOS, Windows, Linux.</h2>
        <p class="intro">
          Die Pakete kommen von den GitHub-Releases, jedes mit SHA256 daneben. Das
          macOS-Paket ist nicht bei Apple beglaubigt: beim ersten Start
          <em>Rechtsklick › Öffnen</em>, danach startet es wie jedes Programm. Windows
          (portables ZIP) und Linux (AppImage) baut und prüft dieselbe CI aus demselben
          Qt-Baum — am Gerät ausprobiert sind sie noch nicht. Ein laufendes Programm
          holt sich die nächste Version selbst: <em>Hilfe › Auf neueste Version
          aktualisieren</em>.
        </p>
      </div>
      <div class="panel dl">
        <div class="panel__head dl__head">
          <span class="caps">Kanal · freigegeben</span>
          <span class="caps num caps--m">v{VERSION} — {STAND}</span>
        </div>
        <div class="dl__body">
          {pakete.map((p) => (
            <div class:list={["dl__item", p.empfohlen && "dl__item--rec"]}>
              <p class:list={["caps", p.empfohlen && "caps--m"]}>{p.empfohlen ? "Für dieses Gerät" : " "}</p>
              <span class="dl__os">{p.os}</span>
              <span class="dl__datei">{p.datei}</span>
              <span class="dl__stand caps"><span class="punkt"></span>{p.stand ?? (p.da ? "Freigegeben" : "Folgt über die CI")}</span>
              <span class="dl__links">
                {p.links.map((l, i) => (
                  <>
                    {i > 0 && <span class="dl__sep">·</span>}
                    <a class="dl__link" href={l.href}>{l.label}</a>
                  </>
                ))}
              </span>
            </div>
          ))}
        </div>
      </div>
      <p class="herkunft">
        <strong>Daten.</strong> Log, Einstellungen und Layout liegen in einer SQLite-Datei
        unter <code>~/Library/Application Support/Contestprogramm/</code> (Windows:
        <code>%AppData%\Contestprogramm</code>, Linux: <code>~/.local/share/Contestprogramm</code>),
        die Sicherungen daneben. Höhendaten (SRTM1) lädt das Programm bei Bedarf und behält sie.
        Quelltext, Tests und Anleitung: <a href={GITHUB}>github.com/oe5sos/Contestprogramm</a>.
      </p>
    </section>
  </main>
</Base>

<style>
  .hero { position: relative; overflow: hidden; border-bottom: 1px solid var(--border-fine); background: var(--bg); }
  .hero__in {
    position: relative; z-index: 2;
    max-width: var(--maxw); margin: 0 auto;
    padding: clamp(4rem, 13vh, 8rem) var(--pad) clamp(2.5rem, 7vh, 4.5rem);
    display: flex; flex-direction: column; gap: 1.2rem; align-items: flex-start;
  }
  .hero__wm {
    font-family: var(--ff-cond); font-weight: 600; letter-spacing: .05em; line-height: 1;
    color: var(--t1); font-size: clamp(2.6rem, 8vw, 6rem);
  }
  .hero__wm2 { color: var(--t4); font-weight: 400; }
  .hero h1 {
    font-size: clamp(1.6rem, 3.6vw, 2.6rem); font-weight: 500;
    color: var(--t2); max-width: 24ch; margin-top: .3rem;
  }
  .hero__sub { max-width: 52ch; margin: 0; font-size: clamp(1rem, 1.8vw, 1.18rem); color: var(--t4); }
  .hero__sub em { color: var(--t2); font-style: normal; }
  .cta { display: flex; flex-wrap: wrap; align-items: center; gap: .7rem; margin-top: .5rem; }

  .readout { border-top: 1px solid var(--border-fine); background: rgba(12,12,14,.72); }
  .readout__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(132px, 1fr)); }
  .readout__cell {
    padding: .95rem 0 .95rem 1.1rem; display: flex; flex-direction: column; gap: .3rem;
    border-left: 1px solid var(--border-fine);
  }
  .readout__cell:first-child { border-left: 0; padding-left: 0; }
  .readout__v { font-family: var(--ff-mono); font-size: .98rem; color: var(--measured-hi); font-variant-numeric: tabular-nums; }
  @media (max-width: 640px) { .readout__cell { border-left: 0; padding-left: 0; } }

  .section { padding-block: clamp(3.5rem, 10vh, 7rem); }
  .section__head { display: flex; flex-direction: column; gap: .8rem; margin-bottom: clamp(2rem, 5vh, 3.2rem); }
  .section__head h2 { font-size: clamp(1.7rem, 3.6vw, 2.6rem); max-width: 22ch; }
  .section__head .intro { margin: 0; color: var(--t4); max-width: 60ch; }

  /* Bildschirmfotos — derselbe Rahmen wie auf der App-Seite. */
  .schirm { margin: 0; display: flex; flex-direction: column; gap: 1rem; }
  .schirm__rahmen {
