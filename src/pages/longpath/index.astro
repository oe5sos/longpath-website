---
import Base from "../../layouts/Base.astro";
import Wordmark from "../../components/Wordmark.astro";
import Screens from "../../components/Screens.astro";
import Spektrum from "../../components/Spektrum.astro";

/* Inhalte aus ../NereusSDR/README.md. Wenn dort eine Version steigt,
   gehoert sie hier mitgezogen — es gibt bisher keine Automatik dafuer. */
const VERSION = "0.5.2";
const DATUM = "24. Mai 2026";

const kette = [
  {
    nr: "01", stufe: "HF ein",
    titel: "Erkennung, die das Gerät auch findet",
    text: "Ein einziger Zustandsautomat: Getrennt → Suchen → Verbinden → Verbunden. Die Unicast-Suche erreicht Geräte auch durch WireGuard-, ZeroTier- und Tailscale-Tunnel, nicht nur im eigenen Broadcast-Bereich. Sechzehn Modelle, nach Chipfamilie sortiert.",
    marken: ["Je MAC gespeichert", "Autoverbindung", "Board-Fähigkeiten"],
  },
  {
    nr: "02", stufe: "Spektrum",
    titel: "Panadapter auf der Grafikkarte",
    text: "QRhi über Metal, Vulkan und D3D12, mit der vollständigen Thetis-Display-Fläche dahinter — Spektrum, Wasserfall, Gitter und Skalen, je Band gespeichert über alle vierzehn Bänder. Clarity verfolgt den Rauschboden und hält das Bild lesbar, während sich das Band darunter bewegt. Neun Anordnungen für mehrere Bandbilder nebeneinander, jedes davon auch als eigenes Fenster auf einem zweiten Bildschirm.",
    marken: ["Clarity-Palette", "Rauschboden EWMA", "9 Anordnungen", "Zoom bleibt"],
  },
  {
    nr: "03", stufe: "Empfang",
    titel: "Zehn WDSP-Bereiche, alle erreichbar",
    text: "Erweiterte AGC, EMNR, SNB, APF, dreifache Rauschsperre, NB2, binaural, RIT und XIT — jeweils bis ins WDSP durchverdrahtet und je Empfänger, je Band gemerkt. Die automatische AGC-Schwelle reitet auf dem Rauschboden mit MOX-Sperre, und das Dämpfungsglied fängt die ADC-Übersteuerung ab, bevor man sie hört.",
    marken: ["EMNR / NR2", "Adaptive Dämpfung", "31 Instrumente"],
  },
  {
    nr: "04", stufe: "Senden",
    titel: "SSB hinaus, PureSignal an",
    text: "Die vollständige Sendekette — zehnbandiger EQ, Leveler, ALC, CFC, CPDR, CESSB und Phasendreher — mit 21 unverändert übernommenen Mikrofonprofilen. PureSignal linearisiert die ganze ANAN-Reihe samt Hermes und HL2, mit Zweiton-IMD über dem Spektrum, wo man das Einrasten tatsächlich zusehen kann.",
    marken: ["PureSignal", "Zweiton-IMD", "DEXP / VOX"],
  },
  {
    nr: "05", stufe: "Der Tisch",
    titel: "Alles, was bisher ein eigenes Programm war",
    text: "Ein TCI-v2.0-Server bedient WSJT-X, JTDX, N1MM und Log4OM ohne virtuelles Kabel. Sieben Spot-Quellen — Cluster, RBN, WSJT-X, DXLab, POTA, FreeDV Reporter, PSK Reporter — landen gestapelt auf dem Bandbild, anklickbar zum Abstimmen. RADE ist eine echte Betriebsart, sendend wie empfangend. Endstufe und Tuner von 4O3A und RF-Kit hängen mit dran.",
    marken: ["TCI v2.0", "Spot-Zentrale", "RADE", "VAX-Audio"],
  },
];

const hardware = [
  { protokoll: "Protokoll 2", titel: "ANAN-G2 & G2 MkII",
    text: "Saturn-Boards auf Orion-MkII-Firmware. Empfang von 80 bis 10 m, sauberer Träger auf TUNE und MOX, PureSignal rastet ein.",
    stand: "RX + TX geprüft", ok: true },
  { protokoll: "Protokoll 1", titel: "Hermes Lite 2",
    text: "SSB-Sendebetrieb freigefahren seit der Dämpfungs- und Filterprüfung. I²C-Steuerung, N2ADR HERCULES, Dämpfungsglied −28…+32 dB.",
    stand: "RX + TX geprüft", ok: true },
  { protokoll: "Protokoll 1 + 2", titel: "ANAN-100D · 200D · 7000/8000DLE",
    text: "Die ganze Apache-Labs-Reihe, mit Vorwärtsleistungs-Kalibrierung je Board und der Übersteuerungssperre für hochverstärkende Endstufen.",
    stand: "RX + TX geprüft", ok: true },
  { protokoll: "Protokoll 1", titel: "Hermes · Angelia · Orion · Metis",
    text: "Die älteren OpenHPSDR-Boards werden erkannt, liefern I/Q und laufen durch WDSP; Dämpfungsglied und Vorverstärker direkt am Board.",
    stand: "RX geprüft", ok: false },
];

/* Was am Tisch sonst noch steht. Quellen: CHANGELOG.md und
   docs/architecture/ im Longpath-Baum. `neu: true` heisst: gebaut,
   aber noch nicht in einer Veroeffentlichung — steht im CHANGELOG
   unter [Unreleased]. */
const werkzeuge = [
  { bereich: "Sendeton", titel: "Ein Kanalzug vor dem Funkgerät",
    text: "Gate, Entzerrer, De-Esser, Kompressor, Röhre, PUDU, Hall und Begrenzer in Signalreihenfolge — am Mikrofon, bevor WDSP es sieht. Abgeschaltet ist der Ton bitgenau der von vorher, der Vergleich also echt und nicht ungefähr. Dazu Voice Check: aufnehmen, der Zug läuft offline darüber, abhören — das Funkgerät taktet dabei nichts.",
    marken: ["8 Stufen", "A/B im Halten", "Voice Check"], neu: true },
  { bereich: "Logbuch", titel: "Verbindungen, die sich wiederfinden lassen",
    text: "Aus der schmalen Leiste wird ein voller Arbeitsplatz: suchen über Rufzeichen, Name, QTH, Land, Feld oder Bemerkung, filtern nach Band und Betriebsart, ADIF und Cabrillo hinein und hinaus. Daneben die Stammdaten von QRZ, die Peilung dorthin und eine Karte.",
    marken: ["ADIF", "Cabrillo", "QRZ", "Karte"], neu: true },
  { bereich: "Antenne", titel: "Der Rotor lernt deine Richtungen",
    text: "Vier Vorwahlen unter der Himmelsrichtungsreihe: Rechtsklick merkt sich die aktuelle Peilung, Linksklick fährt sie wieder an. Dazu Park und der lange Weg. Aus dem Spot-Menü im Bandbild heraus: „Rotor auf dieses Rufzeichen“.",
    marken: ["4 Vorwahlen", "Park", "Langer Weg"], neu: true },
  { bereich: "Diversity", titel: "Zwei Antennen, ein Richtdiagramm",
    text: "Phase und Verstärkung als Polardiagramm, das sich beim Drehen mitbewegt — man sieht die Keule, statt sie zu erraten. Acht Speicherplätze je Band, Klick holt, Rechtsklick legt ab.",
    marken: ["Radar", "8 Speicher je Band"], neu: true },
  { bereich: "Übersicht", titel: "Das ganze Band statt nur des Ausschnitts",
    text: "Auf Protokoll 2 kommt der volle Wandlerbereich als zweiter Datenstrom herein und läuft durch eine eigene FFT. Ein Klick in den Randbereich verschiebt den Empfänger dorthin, ein Klick in die Mitte stimmt nur ab.",
    marken: ["16 384 Punkte", "Klick verschiebt"], neu: true },
  { bereich: "Fremde Geräte", titel: "Auch was kein OpenHPSDR spricht",
    text: "Der SunSDR2 QRP über TCI und öffentliche KiwiSDR-Empfänger aus dem Verzeichnis. Beide hängen an derselben Sicherheitsschranke: ein Empfänger, der an einem echten Sender hängt, wird von dort niemals angefasst.",
    marken: ["SunSDR2 QRP", "KiwiSDR"], neu: true },
];

const pakete = [
  { os: "macOS · Apple Silicon", datei: `Longpath-${VERSION}-arm64.dmg · signiert & notarisiert`, empfohlen: true },
  { os: "Linux", datei: "AppImage · x86_64 + aarch64", empfohlen: false },
  { os: "Windows", datei: "NSIS-Installer · portables ZIP · x64", empfohlen: false },
  { os: "Alle Pakete", datei: "SHA256SUMS.txt.asc · GPG-signiert", empfohlen: false },
];
---

<Base
  titel="Longpath — Stationskonsole für OpenHPSDR"
  beschreibung="Eine native C++20/Qt6-Konsole für ANAN, Hermes und Hermes Lite 2. Panadapter auf der Grafikkarte, WDSP, PureSignal, TCI. macOS, Linux, Windows."
  raum="app"
>
  <header class="hero">
    <Spektrum art="band" grundlinie={0.74} />
    <div class="hero__in">
      <p class="caps">Version {VERSION} · GPLv3</p>
      <div class="hero__wm"><Wordmark /></div>
      <h1>Die ganze Station in einem nativen Fenster.</h1>
      <p class="hero__sub">
        Longpath führt Thetis in <em>C++20 und Qt6</em> weiter — Panadapter auf der
        Grafikkarte, vollständige RX- und TX-Kette, PureSignal, TCI und Spots.
        Drei Plattformen, gemeinsam gebaut und gemeinsam signiert.
      </p>
      <div class="cta">
        <a class="btn" href="#download">Stand der Pakete</a>
        <a class="btn btn--quiet" href="#signalkette">Signalkette ansehen</a>
      </div>
    </div>
    <div class="readout">
      <div class="readout__grid wrap">
        <div class="readout__cell"><span class="caps">Version</span><span class="readout__v">{VERSION}</span></div>
        <div class="readout__cell"><span class="caps">Protokolle</span><span class="readout__v">P1 + P2</span></div>
        <div class="readout__cell"><span class="caps">Bandbreite</span><span class="readout__v">1 536 kHz</span></div>
        <div class="readout__cell"><span class="caps">DSP</span><span class="readout__v">WDSP</span></div>
        <div class="readout__cell"><span class="caps">Pakete</span><span class="readout__v">5</span></div>
      </div>
    </div>
  </header>

  <main>
    <section class="section wrap" id="signalkette">
      <div class="section__head">
        <p class="caps">Von der Antenne bis zum Kopfhörer</p>
        <h2>Ein Weg durch die Station — und Longpath besitzt ihn ganz.</h2>
      </div>
      <div class="kette">
        {kette.map((s) => (
          <article class="stufe">
            <div class="stufe__nr"><span class="caps num">{s.nr} — {s.stufe}</span></div>
            <div class="stufe__text">
              <h3>{s.titel}</h3>
              <p>{s.text}</p>
              <div class="marken">{s.marken.map((m) => <span class="marke">{m}</span>)}</div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section wrap" id="werkzeuge">
      <div class="section__head">
        <p class="caps">Was am Tisch sonst noch steht</p>
        <h2>Alles, wofür sonst ein zweites Programm offen wäre.</h2>
        <p class="intro">
          Was hier mit <em>im Bau</em> gekennzeichnet ist, läuft bereits — es steckt
          aber noch nicht in Version {VERSION}, sondern kommt mit der nächsten.
        </p>
      </div>

      <div class="werk">
        {werkzeuge.map((w) => (
          <article class="panel werk__karte">
            <div class="panel__head">
              <span class="caps num">{w.bereich}</span>
              {w.neu && <span class="werk__neu caps">im Bau</span>}
            </div>
            <div class="werk__body">
              <h3>{w.titel}</h3>
              <p>{w.text}</p>
              <div class="marken">{w.marken.map((m) => <span class="marke">{m}</span>)}</div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section wrap" id="hardware">
      <div class="section__head">
        <p class="caps">Am Gerät geprüft</p>
        <h2>Auf echter Hardware freigefahren, nicht angenommen.</h2>
      </div>
      <div class="hw">
        {hardware.map((h) => (
          <article class="panel karte">
            <div class="panel__head"><span class="caps num">{h.protokoll}</span></div>
            <div class="karte__body">
              <h3>{h.titel}</h3>
              <p>{h.text}</p>
              <span class:list={["kapsel", h.ok ? "kapsel--ok" : "kapsel--rx"]}>
                <span class="punkt"></span>{h.stand}
              </span>
            </div>
          </article>
        ))}
      </div>
    </section>

    <Screens />

    <section class="section wrap" id="sunsdr">
      <div class="section__head">
        <p class="caps">Ein Gerät, das gar kein OpenHPSDR spricht</p>
        <h2>SunSDR2 QRP — über TCI, nicht über einen Boardtreiber.</h2>
      </div>

      <div class="sun">
        <div class="sun__text">
          <p>
            Der SunSDR2 QRP spricht kein OpenHPSDR. Expert Electronics veröffentlicht
            sein Protokoll nicht, es gibt also keinen Boardtreiber zu schreiben. Der
            einzige Weg hinein ist <strong>TCI</strong> — dasselbe Protokoll, das
            Longpath längst als <em>Server</em> spricht, damit WSJT-X und N1MM es
            bedienen können. Hier ist es andersherum: Longpath ist der Client,
            ExpertSDR2 der Server.
          </p>
          <p>
            Das ändert die Rollenverteilung. Bei jedem anderen Gerät rechnet Longpath
            selbst — die Kiste ist ein ADC am Ende einer Leitung. ExpertSDR2 bringt
            seine eigene DSP-Kette mit und entscheidet, was das Gehäuse verlässt.
            Longpath kann dort nicht demodulieren, sondern nur darum bitten, das
            Ergebnis entgegennehmen, anzeigen und hörbar machen.
          </p>
          <p>
            Ton, Bild und Steuerung laufen dabei durch <strong>dieselben Wege wie bei
            einem echten Empfänger</strong> — derselbe Mischer, eine echte FFT am
            reservierten Platz, derselbe Router auf dasselbe Bandbild. Kein zweiter,
            paralleler Pfad, der irgendwann auseinanderläuft.
          </p>
        </div>

        <div class="panel sun__panel">
          <div class="panel__head"><span class="caps">Der Weg hinein</span></div>
          <ol class="schritte">
            <li><span class="caps num">01</span><span>Verbindung — <code>ws://host:40001</code></span></li>
            <li><span class="caps num">02</span><span>Ton — RX-Audio in den Mischer</span></li>
            <li><span class="caps num">03</span><span>Bild — I/Q auf den Panadapter</span></li>
            <li><span class="caps num">04</span><span>Steuerung — Frequenz und Art, beide Richtungen</span></li>
          </ol>
          <div class="sun__stand">
            <span class="kapsel kapsel--ok"><span class="punkt"></span>Am Gerät verifiziert</span>
            <span class="caps num">24.08.2026 · OE5SOS</span>
          </div>
        </div>
      </div>

      <p class="herkunft" style="margin-top:2rem">
        <strong>Die Grenze, die dabei gilt.</strong> Ein Empfänger, der an einem
        echten Gerät hängt, wird über diesen Weg niemals gespeist oder gesteuert —
        in keine Richtung. SunSDR ist ein zweites, unabhängiges Funkgerät; könnte
        sein Zustand in einen Empfänger überlaufen, der zu einem Sender gehört,
        würde sich Hardware verstellen, von der der Betreiber annimmt, dass nur
        Longpath sie in der Hand hat. Wo Zurückhaltung und Sicherheit sich
        widersprechen, gewinnt die Sicherheit.
      </p>
    </section>

    <section class="section wrap" id="download">
      <div class="section__head">
        <p class="caps">Aktueller Stand</p>
        <h2>Noch nichts zum Laden — und das mit Absicht.</h2>
        <p class="intro">
          Die Pakete für alle drei Plattformen werden gemeinsam gebaut und
          gemeinsam signiert. Online gestellt werden sie erst, wenn sie
          <em>am Gerät geprüft</em> sind. Ein Paket, das niemand an echter
          Hardware freigefahren hat, gehört nicht auf eine Seite, auf der
          jemand einen Sender damit betreibt.
        </p>
      </div>
      <div class="panel dl">
        <div class="panel__head dl__head">
          <span class="caps">Kanal · in Prüfung</span>
          <span class="caps num caps--m">v{VERSION} — {DATUM}</span>
        </div>
        <div class="dl__body">
          {pakete.map((p) => (
            <div class:list={["dl__item", p.empfohlen && "dl__item--rec"]}>
              <p class:list={["caps", p.empfohlen && "caps--m"]}>
                {p.empfohlen ? "Für dieses Gerät" : " "}
              </p>
              <span class="dl__os">{p.os}</span>
              <span class="dl__datei">{p.datei}</span>
              <span class="dl__stand caps">
                <span class="punkt"></span>Noch nicht freigegeben
              </span>
            </div>
          ))}
        </div>
      </div>

      <p class="herkunft">
        <strong>Herkunft.</strong> Longpath ist ein Fork von NereusSDR (J. J. Boyd, KG4VCF),
        selbst eine C++20/Qt6-Portierung von Thetis — FlexRadio Systems, Doug Wigley (W5WC),
        Richard Samphire (MW0LGE) und die OpenHPSDR-Beitragenden. Das DSP ist WDSP von
        Warren Pratt (NR0V). Architektur und wesentlicher Code stammen aus AetherSDR
        (Jeremy, KK7GWY). Jeder Urhebervermerk steht unverändert im Quellbaum. GPLv3,
        wie es die Vorlagen verlangen.
      </p>
    </section>
  </main>
</Base>

<style>
  .hero { position: relative; overflow: hidden; border-bottom: 1px solid var(--border-fine); }
  /* Der Schleier liegt zwischen Zeichnung und Schrift. Oben dunkler,
     damit die Leiste sich nicht auf dem Wasserfall abzeichnet; unten
     fast deckend, damit das Ablesegitter ruhig steht. */
  .hero::after {
    content: ""; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(to bottom,
      rgba(8,8,10,.74) 0%, rgba(8,8,10,.44) 40%, rgba(8,8,10,.9) 100%);
  }
  .hero .readout { position: relative; z-index: 2; }
  .hero__in {
    position: relative; z-index: 2;
    max-width: var(--maxw); margin: 0 auto;
    padding: clamp(4rem, 13vh, 8rem) var(--pad) clamp(2.5rem, 7vh, 4.5rem);
    display: flex; flex-direction: column; gap: 1.2rem; align-items: flex-start;
  }
  .hero__wm :global(.wm) { font-size: clamp(3rem, 9.5vw, 7rem); }
  .hero h1 {
    font-size: clamp(1.6rem, 3.6vw, 2.6rem); font-weight: 500;
    color: var(--t2); max-width: 24ch; margin-top: .3rem;
  }
  .hero__sub { max-width: 52ch; margin: 0; font-size: clamp(1rem, 1.8vw, 1.18rem); color: var(--t4); }
  .hero__sub em { color: var(--t2); font-style: normal; }
  .cta { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: .5rem; }

  .readout { border-top: 1px solid var(--border-fine); background: rgba(12,12,14,.72); }
  .readout__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(132px, 1fr)); }
  .readout__cell {
    padding: .95rem 0 .95rem 1.1rem; display: flex; flex-direction: column; gap: .3rem;
    border-left: 1px solid var(--border-fine);
  }
  .readout__cell:first-child { border-left: 0; padding-left: 0; }
  .readout__v { font-family: var(--ff-mono); font-size: .98rem; color: var(--measured-hi); font-variant-numeric: tabular-nums; }
  @media (max-width: 640px) { .readout__cell { border-left: 0; padding-left: 0; } }

  .section { padding-block: clamp(3.5rem, 10vh, 7rem); }
  .section__head { display: flex; flex-direction: column; gap: .8rem; margin-bottom: clamp(2rem, 5vh, 3.2rem); }
  .section__head h2 { font-size: clamp(1.7rem, 3.6vw, 2.6rem); max-width: 22ch; }

  .kette { display: flex; flex-direction: column; }
  .stufe {
    display: grid; grid-template-columns: 6.5rem 1fr; gap: clamp(1rem, 4vw, 2.8rem);
    padding-block: clamp(1.6rem, 3.6vh, 2.5rem);
    border-top: 1px solid var(--border-fine); align-items: start;
  }
  .stufe:last-child { border-bottom: 1px solid var(--border-fine); }
  .stufe__nr { padding-top: .4rem; }
  .stufe__text { display: flex; flex-direction: column; gap: .5rem; }
  .stufe__text h3 { font-size: clamp(1.25rem, 2.4vw, 1.6rem); font-weight: 500; }
  .stufe__text p { margin: 0; color: var(--t4); max-width: 60ch; }
  .marken { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: .3rem; }
  .marke {
    font-family: var(--ff-mono); font-size: 9px; letter-spacing: .14em; text-transform: uppercase;
    color: var(--t5); background: var(--btn); border: 1px solid var(--border-fine);
    border-radius: var(--radius-s); padding: .3rem .55rem;
  }
  @media (max-width: 560px) { .stufe { grid-template-columns: 1fr; gap: .45rem; } .stufe__nr { padding-top: 0; } }

  .werk { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1rem; }
  .werk__karte { display: flex; flex-direction: column; }
  .werk__karte .panel__head { justify-content: space-between; }
  .werk__neu {
    color: var(--measured); border: 1px solid var(--measured-border, #6b5426);
    background: var(--measured-bg, #33280f); border-radius: var(--radius-s);
    padding: .2rem .45rem; flex-shrink: 0;
  }
  .werk__body { padding: 1.1rem .9rem 1rem; display: flex; flex-direction: column; gap: .6rem; flex: 1; }
  .werk__body h3 { font-size: 1.12rem; font-weight: 500; }
  .werk__body p { margin: 0; font-size: .95rem; color: var(--t4); }
  .werk__body .marken { margin-top: auto; padding-top: .6rem; }

  .section__head .intro { margin: 0; color: var(--t4); max-width: 60ch; }
  .section__head .intro em { color: var(--measured); font-style: normal; }

  .hw { display: grid; grid-template-columns: repeat(auto-fit, minmax(255px, 1fr)); gap: 1rem; }
  .karte { display: flex; flex-direction: column; }
  .karte__body { padding: 1.1rem .9rem 1rem; display: flex; flex-direction: column; gap: .5rem; flex: 1; }
  .karte__body h3 { font-size: 1.1rem; font-weight: 500; }
  .karte__body p { margin: 0; font-size: .95rem; color: var(--t4); }
  /* Regel 5 — Zustand als umrandete Kapsel, immer an derselben Stelle */
  .kapsel {
    margin-top: auto; align-self: flex-start;
    display: inline-flex; align-items: center; gap: .45rem;
    font-family: var(--ff-mono); font-size: 9px; letter-spacing: .16em; text-transform: uppercase;
    border-radius: var(--radius-s); padding: .32rem .6rem; border: 1px solid;
  }
  .kapsel--ok { color: var(--ok); border-color: var(--ok-border); background: var(--ok-bg); }
  .kapsel--rx { color: var(--t3); border-color: var(--border-2); background: var(--btn); }
  .punkt { width: 5px; height: 5px; border-radius: 50%; background: currentColor; flex-shrink: 0; }

  .dl__head { height: auto; min-height: 34px; padding: .5rem 1rem; display: flex; justify-content: space-between; flex-wrap: wrap; gap: .8rem; }
  .dl__body { display: grid; grid-template-columns: repeat(auto-fit, minmax(215px, 1fr)); }
  .dl__item { padding: 1.2rem 1.1rem; display: flex; flex-direction: column; gap: .35rem; border-left: 1px solid var(--border-fine); }
  .dl__item:first-child { border-left: 0; }
