---
/**
 * Die Bildschirmfotos der Oberflaeche.
 *
 * Kein Foto-Grade: was hier gezeigt wird, ist die Oberflaeche selbst,
 * und die hat ihre Farben schon entschieden. Nur Rahmen und Groesse.
 *
 * Der Abschnitt verschwindet vollstaendig, solange keine Aufnahme in
 * src/assets/screens/ liegt — eine leere Galerie ist schlimmer als
 * gar keine.
 */
import { Image } from "astro:assets";
import { SCHIRME } from "../screens";

const gefunden = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/screens/*.{png,jpg,jpeg,webp}",
  { eager: true },
);

const schirme = Object.entries(gefunden)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([pfad, modul], i) => {
    const name = pfad.split("/").pop()!.replace(/\.\w+$/, "");
    const schluessel = name.replace(/^\d+[-_]?/, "");
    return {
      nr: String(i + 1).padStart(2, "0"),
      bild: modul.default,
      ...(SCHIRME[schluessel] ?? { bereich: schluessel, titel: "", text: "" }),
    };
  });
---

{schirme.length > 0 && (
  <section class="section wrap" id="oberflaeche">
    <div class="section__head">
      <p class="caps">Die Oberfläche</p>
      <h2>Ein dichter Arbeitsplatz, der sich trotzdem lesen lässt.</h2>
    </div>

    <div class="schirme">
      {schirme.map((s) => (
        <figure class="schirm">
          <div class="schirm__rahmen">
            <Image
              src={s.bild}
              alt={s.titel || s.bereich}
              widths={[720, 1200, 1800]}
              sizes="(max-width: 900px) 100vw, 1100px"
              loading="lazy"
              format="webp"
              quality={92}
            />
          </div>
          <figcaption>
            <span class="caps num">{s.nr} — {s.bereich}</span>
            {s.titel && <h3>{s.titel}</h3>}
            {s.text && <p>{s.text}</p>}
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
)}

<style>
  .schirme { display: flex; flex-direction: column; gap: clamp(2.5rem, 7vh, 5rem); }

  .schirm { margin: 0; display: flex; flex-direction: column; gap: 1rem; }

  /* Der Rahmen ist ein Panel wie im Programm, nur ohne Kopf: feine
     Kante, Lichtkante oben, sonst nichts. Ein Schlagschatten waere
     Dekoration und faellt unter die Zwei-Prozent-Regel. */
  .schirm__rahmen {
    border: 1px solid var(--border-fine);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--panel);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.04);
    line-height: 0;
  }
  .schirm__rahmen :global(img) { width: 100%; height: auto; display: block; }

  figcaption { display: flex; flex-direction: column; gap: .4rem; max-width: 62ch; }
  figcaption h3 {
    font-family: var(--ff-cond); font-weight: 500;
    font-size: clamp(1.15rem, 2.2vw, 1.5rem); color: var(--t1); margin: 0;
  }
  figcaption p { margin: 0; color: var(--t4); }
</style>
