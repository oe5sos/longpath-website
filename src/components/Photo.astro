---
/**
 * Ein Foto.
 *
 * Die Gradation steckt NICHT hier, sondern in scripts/grade-photos.mjs:
 * jedes Bild ist schon einheitlich entsaettigt und kontrastiert, bevor
 * Astro es anfasst. Hier bleiben nur Zuschnitt, Groessen und die
 * Vignette — und die Vignette ist ein Overlay, kein Filter, damit sie
 * sich nicht mit der gebackenen Gradation stapelt.
 */
import { Image } from "astro:assets";

type Format = "quer" | "breit" | "hoch" | "pano";

interface Props {
  bild: ImageMetadata;
  alt: string;
  /** Kennzeichnung unten links, z. B. "OE/OO-023 · 1 691 m" */
  ref?: string;
  format?: Format;
  /** Erstes Bild einer Seite: eifrig laden statt lazy. */
  vordergrund?: boolean;
  sizes?: string;
}

const {
  bild, alt, ref,
  format = "quer",
  vordergrund = false,
  sizes = "(max-width: 800px) 100vw, 800px",
} = Astro.props;

const verhaeltnis: Record<Format, string> = {
  quer:  "3 / 2",
  breit: "16 / 9",
  hoch:  "4 / 5",
  pano:  "21 / 9",
};
---

<figure class="photo" style={`--ar: ${verhaeltnis[format]}`}>
  <Image
    src={bild}
    alt={alt}
    widths={[480, 800, 1200, 1800]}
    sizes={sizes}
    loading={vordergrund ? "eager" : "lazy"}
    fetchpriority={vordergrund ? "high" : "auto"}
    format="avif"
  />
  {ref && <figcaption class="photo__ref">{ref}</figcaption>}
</figure>

<style>
  .photo {
    position: relative;
    display: block;
    width: 100%;
    margin: 0;
    aspect-ratio: var(--ar);
    overflow: hidden;
    background: var(--panel);
    border: 1px solid var(--border-fine);
    border-radius: var(--radius);
    isolation: isolate;
  }
  .photo :global(img) {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;           /* einheitliche Rahmung */
    transition: transform .9s cubic-bezier(.22,.7,.3,1);
  }
  /* Vignette und warme Tiefen — nie Blau. */
  .photo::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(118% 100% at 50% 48%, transparent 44%, rgba(8,8,10,.52) 100%),
      linear-gradient(to top, rgba(194,146,79,.07), transparent 52%);
  }
  :global(a:hover) .photo :global(img) { transform: scale(1.03); }

  .photo__ref {
    position: absolute;
    z-index: 2;
    left: .8rem;
    bottom: .7rem;
    font-family: var(--ff-mono);
    font-size: 9px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: rgba(220,220,225,.9);
    text-shadow: 0 1px 6px rgba(0,0,0,.9);
    font-variant-numeric: tabular-nums;
  }
</style>
