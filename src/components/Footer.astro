---
import { useTranslations } from "../i18n/utils";
import { DEFAULT_LOCALE, type Locale } from "../i18n/ui";
import LangSwitch from "./LangSwitch.astro";

interface Props { raum: "app" | "blog"; lang: Locale; }
const { raum, lang } = Astro.props;
const t = useTranslations(lang);

// Dieselbe Regel wie in Nav.astro: jede dieser Adressen gibt es je Sprache.
const appHref = (pfad: string) => (lang === DEFAULT_LOCALE ? pfad : `/${lang}${pfad}`);
---
<footer class="foot">
  <div>
    <p class="caps">OE5SOS · Martin Fischer</p>
    <p class="caps num" style="margin:.4rem 0 0">
      {t.footer.ort} · JN67{raum === "blog" ? ` · ${t.footer.portabel}` : ""}
    </p>
    <div style="margin-top: .9rem"><LangSwitch lang={lang} /></div>
  </div>
  <div class="foot__cols">
    <div class="foot__col">
      {raum === "app" ? (
        <>
          <a href={appHref("/longpath/#download")}>{t.footer.appCol.versionen}</a>
          <a href={appHref("/longpath/#hardware")}>{t.footer.appCol.hardware}</a>
          <a href={appHref("/longpath/#signalkette")}>{t.footer.appCol.signalkette}</a>
        </>
      ) : (
        <>
          <a href={appHref("/blog/")}>{t.footer.blogCol.beitraege}</a>
          <a href={appHref("/blog/archiv/")}>{t.footer.blogCol.archiv}</a>
          <a href={appHref("/blog/rss.xml")}>{t.footer.blogCol.rss}</a>
        </>
      )}
    </div>
    <div class="foot__col">
      <a href={raum === "app" ? appHref("/blog/") : appHref("/longpath/")}>{raum === "app" ? t.footer.zumBlog : t.footer.zurApp}</a>
      <a href={appHref("/")}>{t.footer.start}</a>
      <a href={appHref("/impressum/")}>{t.footer.impressum}</a>
    </div>
  </div>
</footer>

<style>
  .foot {
    border-top: 1px solid var(--border-fine);
    margin-top: clamp(3rem, 7vh, 5rem);
    padding-block: clamp(2.2rem, 5vh, 3.5rem);
    display: flex; flex-wrap: wrap; gap: 1.5rem;
    justify-content: space-between; align-items: flex-end;
  }
  .foot__cols { display: flex; flex-wrap: wrap; gap: clamp(1.5rem, 5vw, 3.5rem); }
  .foot__col { display: flex; flex-direction: column; gap: .45rem; }
  .foot__col a {
    font-family: var(--ff-mono); font-size: 9px;
    letter-spacing: .18em; text-transform: uppercase;
    color: var(--t5); transition: color var(--ease);
  }
  .foot__col a:hover { color: var(--t2); }
</style>
