---
import BaseHead from "../components/BaseHead.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { DEFAULT_LOCALE, LOCALE_TAG, type Locale } from "../i18n/ui";
import "../styles/global.css";

interface Props {
  titel: string;
  beschreibung: string;
  raum: "app" | "blog";
  vorschau?: string;
  /** Startseite: ohne Leiste und Fuss. */
  nackt?: boolean;
}
const { titel, beschreibung, raum, vorschau, nackt = false } = Astro.props;
const lang = (Astro.currentLocale as Locale | undefined) ?? DEFAULT_LOCALE;
---
<!doctype html>
<html lang={LOCALE_TAG[lang]}>
  <head><BaseHead titel={titel} beschreibung={beschreibung} vorschau={vorschau} /></head>
  <body>
    {!nackt && <Nav raum={raum} pfad={Astro.url.pathname} lang={lang} />}
    <slot />
    {!nackt && <div class="wrap"><Footer raum={raum} lang={lang} /></div>}
  </body>
</html>
